---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EuBadges from '../components/EuBadges.astro';
const all = (await getCollection('destinations')).map(e => e.data);
const countries = new Set(all.map(d => d.countryName)).size;
const stats = [[String(all.length),'Live destinations'],[String(countries),'Countries'],['48h','To launch'],['100%','EU-hosted']];
---
<Base title="For destination marketing organisations" angle="dmo" concierge>
  <section class="mx-auto max-w-6xl px-5 py-14">
    <p class="mb-3 text-xs font-bold tracking-widest text-(--color-pine) uppercase">For destination marketing organisations</p>
    <h1 class="h-display">Your destination's data,<br />finally answering questions.</h1>
    <p class="lede mt-5">If your region publishes to one of our connected platforms, we already read the feed. You can be live in 48 hours.</p>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a href="/destinations" class="rounded-full bg-(--color-pine) px-6 py-3 font-semibold text-white">Open any of {all.length} live destinations</a>
      <a href="/pricing" class="rounded-full border border-(--color-line) px-6 py-3 font-semibold">See pricing</a>
    </div>
    <p class="mt-4 max-w-[58ch] text-sm text-(--color-ink-2)">
      <b>No demo request, no form, no sales call.</b> Every destination on this site is a running concierge
      answering from live data. Open one, try to break it, and only then talk to us.
    </p>
    <EuBadges />
  </section>
  <section class="border-y border-(--color-line-2) bg-(--color-paper-2) py-10">
    <div class="mx-auto grid max-w-6xl grid-cols-2 overflow-hidden rounded-xl border border-(--color-line) bg-white md:grid-cols-4">
      {stats.map(([n,l]) => (
        <div class="border-r border-(--color-line-2) p-5 last:border-r-0">
          <b class="block font-serif text-3xl">{n}</b>
          <span class="text-xs font-bold tracking-wider text-(--color-ink-3) uppercase">{l}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14">
    <p class="text-xs font-bold tracking-widest text-(--color-pine) uppercase">Why this and not a generic chatbot</p>
    <h2 class="h-section mt-2">Twelve things a wrapper around ChatGPT cannot do</h2>
    <p class="lede mt-4">
      Anyone can put a chat box on a tourism website. What follows is the part that takes a tourism
      ontology, licensed data connections and six years of edge cases — we started building this in 2020.
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="rounded-2xl border border-(--color-line) bg-white p-6">
        <h3 class="font-serif text-xl font-semibold">It runs on your real data</h3>
        <ul class="mt-4 space-y-3 text-sm text-(--color-ink-2)">
          <li><b class="text-(--color-ink)">Official tourism data sources where available.</b> Your national or regional platform, licensed and credited — not a crawl of your website.</li>
          <li><b class="text-(--color-ink)">Broad coverage in one place.</b> Events, gastronomy, accommodation, rental, trails, cruises. A visitor who gets a complete answer from you does not go and look for it on an OTA.</li>
          <li><b class="text-(--color-ink)">Choice of model, per destination.</b> Mistral, OpenAI, Anthropic Claude, Google Gemini or DeepSeek. A European destination can keep the whole chain in the EU on Mistral; Beijing or Shanghai can run DeepSeek; San Francisco can run Claude. The model follows your jurisdiction and your audience, not our preference.</li>
          <li><b class="text-(--color-ink)">Your branding, per destination.</b> Your logo, your colours, your voice — not ours.</li>
        </ul>
      </div>

      <div class="rounded-2xl border border-(--color-line) bg-white p-6">
        <h3 class="font-serif text-xl font-semibold">It answers, it doesn't just chat</h3>
        <ul class="mt-4 space-y-3 text-sm text-(--color-ink-2)">
          <li><b class="text-(--color-ink)">Rich, visual answers.</b> Images where the data carries them, with buttons that do something: website, socials, itineraries, and where available a table booking or a tee time.</li>
          <li><b class="text-(--color-ink)">Distinctions shown, not buried.</b> Michelin stars and keys, green stars, Gault&amp;Millau toques, Soles Repsol — the marks a visitor is actually choosing on.</li>
          <li><b class="text-(--color-ink)">UNESCO sites flagged</b> wherever they appear in an answer.</li>
          <li><b class="text-(--color-ink)">Trails with duration and distance</b>, so “a two-hour walk” returns something you can actually do in two hours.</li>
          <li><b class="text-(--color-ink)">Your city, region or national card</b> and its benefits surfaced in the answer, at the moment the visitor is deciding.</li>
        </ul>
      </div>

      <div class="rounded-2xl border border-(--color-line) bg-white p-6">
        <h3 class="font-serif text-xl font-semibold">It works at your scale</h3>
        <ul class="mt-4 space-y-3 text-sm text-(--color-ink-2)">
          <li><b class="text-(--color-ink)">Zoom in on a big city</b> — down to individual neighbourhoods, so “near where I’m staying” means something.</li>
          <li><b class="text-(--color-ink)">Zoom out to a region or département</b> — search across the towns within it from one concierge, which is how a regional body actually works.</li>
          <li><b class="text-(--color-ink)">Plans up to a year ahead.</b> Seasonal events and opening periods, not just what is on this week.</li>
        </ul>
      </div>

      <div class="rounded-2xl border border-(--color-pine) bg-(--color-pine-l) p-6">
        <h3 class="font-serif text-xl font-semibold">The one that pays for it</h3>
        <p class="mt-3 text-(--color-ink-2)">
          Every question your concierge answers completely is a visitor who did not open a new tab and
          finish their trip on an OTA. Coverage across events, dining, stays, rental and trails is not a
          feature list — it is <b>leakage prevention</b>. The commission that does not leave your
          destination stays in your destination.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="rounded-2xl border border-(--color-pine) bg-(--color-pine-l) p-7">
      <h2 class="h-section">You earn from enrichment in your destination</h2>
      <p class="mt-3 max-w-[72ch] text-(--color-ink-2)">
        Hotels, restaurants, museums and rental operators in your area can pay to enrich their own records.
        <b> You receive 30% of that revenue</b>, for as long as your destination is live with us — and a
        dashboard showing exactly which records are owner-enriched, <b>with the right to reject any of
        them</b>. Nobody buys placement; they only buy being described properly.
      </p>
      <dl class="mt-6 grid gap-5 sm:grid-cols-3">
        <div>
          <dt class="text-sm font-semibold">One destination earns per record</dt>
          <dd class="mt-1.5 text-sm text-(--color-ink-2)">
            The share follows the narrowest live destination covering that business — the town before its
            region, the region before its province or département. It is never split across levels. Where
            the narrowest level is not live with us, it passes up to the next one that is.
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold">Three ways to take it</dt>
          <dd class="mt-1.5 text-sm text-(--color-ink-2)">
            Paid out quarterly, credited against your own subscription, or — where your organisation
            cannot accept commission — put towards DM2find joining your paid partner programme once the
            balance covers the membership. You choose, and you can change it once a year.
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold">Enrichment never buys ranking</dt>
          <dd class="mt-1.5 text-sm text-(--color-ink-2)">
            A paid record is a more complete record and nothing else. The concierge answers on relevance
            to the question asked, and you can reject any enrichment that misrepresents your destination.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>
