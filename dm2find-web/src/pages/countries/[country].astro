---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DestinationCard from '../../components/DestinationCard.astro';

export async function getStaticPaths() {
  const all = (await getCollection('destinations')).map(e => e.data);
  const sources = (await getCollection('sources')).map(e => e.data);
  const byCountry = new Map<string, typeof all>();
  for (const d of all) {
    const k = d.country.toLowerCase();
    byCountry.set(k, [...(byCountry.get(k) ?? []), d]);
  }
  return [...byCountry].map(([code, dests]) => ({
    params: { country: code },
    props: { dests, name: dests[0].countryName,
             source: sources.find(s => s.id === dests.find(d => d.dataSource)?.dataSource) ?? null },
  }));
}
const { dests, name, source } = Astro.props;
const official = dests.filter(d => d.provenance === 'official').length;
---
<Base title={name} description={`${dests.length} live concierges in ${name}.`}>
  <section class="mx-auto max-w-6xl px-5 py-12">
    <nav class="text-sm text-(--color-ink-3)"><a href="/destinations">Destinations</a> → {name}</nav>
    <h1 class="h-display mt-4">{name}</h1>
    <p class="lede mt-4">
      {dests.length} live {dests.length === 1 ? 'concierge' : 'concierges'} in {name}
      {official > 0 && source ? `, ${official} of them running on ${source.name}.` : '.'}
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {dests.map(d => <DestinationCard d={d} />)}
    </div>
  </section>
</Base>
