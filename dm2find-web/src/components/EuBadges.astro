---
/**
 * Official "Software Made in Europe" / "Software Hosted in Europe" 2026 badges.
 * Files live in public/badges/. A badge only renders if we actually hold the
 * asset — a missing file must not leave a broken image on a page whose whole
 * argument is that we do not overclaim.
 */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;

const badges = [
  { src: '/badges/software-made-in-europe-2026.png',   alt: 'Software Made in Europe 2026' },
  { src: '/badges/software-hosted-in-europe-2026.png', alt: 'Software Hosted in Europe 2026' },
];
/** Listed explicitly so a badge never renders without its file present. */
const shipped = new Set([
  '/badges/software-made-in-europe-2026.png',
  '/badges/software-hosted-in-europe-2026.png',
]);
const show = badges.filter(b => shipped.has(b.src));
---
<div class={`flex flex-wrap items-center gap-6 ${compact ? '' : 'mt-7'}`}>
  {show.map(b => (
    <img src={b.src} alt={b.alt} width="200" height="103" loading="lazy" decoding="async"
         class="h-auto w-[180px] sm:w-[200px]" />
  ))}
</div>
