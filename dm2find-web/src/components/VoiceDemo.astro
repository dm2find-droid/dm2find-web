---
/**
 * Inline ElevenLabs voice demo — a real destination concierge you can talk to.
 *
 * Distinct from <Concierge />: that one is the fixed corner widget that answers
 * DMOs' questions about DM2find itself. This one is the product, in voice form,
 * for one named destination.
 *
 * Same lazy-load contract as Concierge: nothing is requested from unpkg.com or
 * elevenlabs.io until the visitor taps. The sovereignty claim on /platform stays
 * literally true on this page too, and a microphone agent should not exist
 * before someone has asked for it.
 */
interface Props { agentId: string; place: string }
const { agentId, place } = Astro.props;
---
<div id="vd" data-agent={agentId}
     class="rounded-2xl border border-(--color-line) bg-white p-8 text-center">
  <button id="vd-open" class="mx-auto flex flex-col items-center gap-4">
    <span class="grid h-20 w-20 place-items-center rounded-full bg-(--color-terra) text-3xl text-white transition hover:brightness-110">🎙</span>
    <span class="text-sm font-semibold text-(--color-ink)">Tap to speak with the {place} concierge</span>
  </button>
  <div id="vd-slot" class="mt-2"></div>
</div>
<p id="vd-note" class="mt-3 text-xs text-(--color-ink-3)">
  Voice runs on ElevenLabs (US) — the one part of the stack that cannot be kept in the EU today.
  It loads only when you tap, and will ask for your microphone.
</p>

<script>
  const box  = document.getElementById('vd');
  const btn  = document.getElementById('vd-open');
  btn?.addEventListener('click', () => {
    const id = box!.dataset.agent!;
    btn.remove();
    const el = document.createElement('elevenlabs-convai');
    el.setAttribute('agent-id', id);
    document.getElementById('vd-slot')!.appendChild(el);
    const s = document.createElement('script');
    s.src = 'https://unpkg.com/@elevenlabs/convai-widget-embed';
    s.async = true;
    document.body.appendChild(s);
  }, { once: true });
</script>
