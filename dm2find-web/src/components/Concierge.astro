---
/**
 * ElevenLabs voice agent — answers DMOs' spoken questions about DM2find itself.
 * This is NOT the product demo: the destination concierge is our own webchat,
 * embedded on every /destinations/* page. Keep the two apart.
 *
 * Loaded lazily, on click only. Nothing from unpkg.com or elevenlabs.io is
 * requested until the visitor asks for it. Two reasons that matters here:
 *  1. /platform/sovereignty claims an EU-hosted stack with no third-party
 *     tracking. A US script firing on page load would quietly make that untrue.
 *  2. It is a microphone agent — the visitor should opt in before it exists.
 */
interface Props { agentId?: string }
const { agentId = 'agent_9901kxekjtptffn865av645chsd0' } = Astro.props;
---
<div id="el-wrap" class="fixed right-5 bottom-5 z-40" data-agent={agentId}>
  <button id="el-open"
    class="flex items-center gap-2.5 rounded-full bg-(--color-terra) px-5 py-3.5 font-semibold text-white shadow-lg transition hover:brightness-110">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.8"/>
      <path d="M5 11a7 7 0 0 0 14 0M12 18v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
    Ask about the platform
  </button>
  <p id="el-note" class="mt-2 max-w-[13rem] text-right text-[11px] leading-snug text-(--color-ink-3)">
    Voice agent for questions about DM2find. Runs on ElevenLabs (US); loads only when you tap, and will ask for your microphone.
  </p>
</div>

<script>
  const wrap = document.getElementById('el-wrap');
  const btn  = document.getElementById('el-open');
  btn?.addEventListener('click', () => {
    const id = wrap!.dataset.agent!;
    btn.remove();
    document.getElementById('el-note')?.remove();
    const el = document.createElement('elevenlabs-convai');
    el.setAttribute('agent-id', id);
    wrap!.appendChild(el);
    const s = document.createElement('script');
    s.src = 'https://unpkg.com/@elevenlabs/convai-widget-embed';
    s.async = true;
    document.body.appendChild(s);
  }, { once: true });
</script>
