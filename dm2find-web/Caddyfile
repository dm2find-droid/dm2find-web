# DM2find.ai — static site. TLS and the public hostname are handled by Coolify's
# Traefik in front of this container, so this listens plain on :80.
:80 {
	root * /srv
	encode zstd gzip
	try_files {path} {path}/ {path}.html /404.html
	file_server

	# fingerprinted build output is immutable; HTML must never be cached
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# ---- legacy Grav URLs (extend from the redirect map) ----
	redir /en                                        /            301
	redir /en/tourism                                /destinations 301
	redir /en/tourism/continental-europe             /destinations 301
	redir /en/tourism/continental-europe/france      /countries/fr 301
	redir /en/tourism/continental-europe/germany     /countries/de 301
	redir /en/tourism/continental-europe/belgium     /countries/be 301
	redir /en/tourism/continental-europe/spain       /countries/es 301
	redir /en/tourism/continental-europe/italy       /countries/it 301
	redir /en/tourism/continental-europe/the-netherlands /countries/nl 301
	redir /en/tourism/north-america                  /countries/us 301
	redir /en/tourism/voice                          /channels     301
	redir /en/tourism/tourism-faq                    /dmo          301
	redir /en/connect/connect-voice                  /channels     301
	redir /en/connect*                               /channels     301
	redir /en/sports                                 /solutions    301
	redir /en/education                              /solutions    301
	redir /en/venues                                 /solutions    301
	redir /en/wellness                               /solutions    301
	redir /en/about/contact                          /contact      301
	redir /en/about*                                 /about        301

	# retired channels — these pages must not come back
	redir /en/connect/kakaotalk /channels 301
	redir /en/connect/zalo      /channels 301
}
