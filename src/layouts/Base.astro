---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Concierge from '../components/Concierge.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props { title: string; description?: string; angle?: string; jsonLd?: object; concierge?: boolean }
const { title, description = 'AI travel concierges built on the tourism data destinations already publish.',
        angle = 'traveller', jsonLd, concierge = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · DM2find.ai</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {/* SVG first for browsers that support it, .ico as the fallback every
      browser and bookmark bar understands. Both are needed. */}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#1F5B4E" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body class="antialiased">
  <Header />
  <main><slot /></main>
  <Footer />
  {concierge && <Concierge />}
  <Lightbox />
  <script>
    /* Safety net for the same rule linkAttrs() applies at build time: any link
       leaving DM2find opens in a new tab. It exists because links also arrive
       from destinations.json — tourist office sites, city passes, image credits
       — and one forgotten spread should not send a reader off the site.
       Build-time attributes stay authoritative; this only fills gaps. */
    for (const a of document.querySelectorAll('a[href^="http"]')) {
      const el = a as HTMLAnchorElement;
      if (/(^|\.)dm2find\.(ai|com)$/i.test(el.hostname)) continue;
      if (el.target) continue;
      el.target = '_blank';
      el.rel = (el.rel ? el.rel + ' ' : '') + 'noopener noreferrer';
    }
  </script>
</body>
</html>
