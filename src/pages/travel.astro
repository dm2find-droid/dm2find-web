---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DestinationCard from '../components/DestinationCard.astro';
const all = (await getCollection('destinations')).map(e => e.data);
const picks = ['bordeaux','paris','groningen','bolzano','helsinki','seoul']
  .map(s => all.find(d => d.slug === s)).filter(Boolean);
---
<Base title="For travellers" angle="traveller"
      description="Ask any destination anything. Free, no account, answers from the destination's own tourism data.">
  <section class="mx-auto max-w-4xl px-5 py-14">
    <p class="mb-3 text-xs font-bold tracking-widest text-(--color-terra) uppercase">For travellers · free, always</p>
    <h1 class="h-display">Somebody who<br />knows the place.</h1>
    <p class="lede mt-5">
      Ask in your own words, in your own language. Answers come from the destination's own tourism
      data — the same records the tourist office publishes — kept current, and filled in by the
      businesses themselves.
    </p>
    <a href="/destinations" class="mt-7 inline-block rounded-full bg-(--color-terra) px-6 py-3 font-semibold text-white">
      Find your destination →
    </a>

    <div class="my-12 h-px bg-(--color-line)"></div>

    <div class="grid gap-8 sm:grid-cols-3">
      <div><h2 class="text-base font-semibold">Not a search box</h2>
        <p class="mt-2 text-sm text-(--color-ink-2)">“Somewhere quiet with a terrace, walking distance
        from the old town, open on a Monday” — it understands all of that.</p></div>
      <div><h2 class="text-base font-semibold">Current, not crawled</h2>
        <p class="mt-2 text-sm text-(--color-ink-2)">Opening hours and events come from the destination's
        official feed, not from a page someone scraped two years ago.</p></div>
      <div><h2 class="text-base font-semibold">Nothing to install</h2>
        <p class="mt-2 text-sm text-(--color-ink-2)">No app, no account, no cookie wall. Open the page
        and start asking.</p></div>
    </div>

    <p class="mt-10 border-l-4 border-(--color-line) pl-4 text-sm text-(--color-ink-3)">
      dm2find.com redirects here — one home for travellers.
    </p>
  </section>

  <section class="border-y border-(--color-line-2) bg-(--color-paper-2) py-12">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="h-section">A few places to start</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {picks.map(d => <DestinationCard d={d!} />)}
      </div>
    </div>
  </section>
</Base>
