---
import ConnectLayout from '../../layouts/ConnectLayout.astro';
import ConnectCodeField from '../../components/ConnectCodeField.astro';
---
<ConnectLayout title="Connect Instagram Direct">
  <h1>Connect Instagram Direct</h1>
  <p class="lead">Visitors who send your destination's Instagram account a direct message get instant answers from your AI Travel Concierge.</p>

  <section class="card">
    <h2>Before you start</h2>
    <ul>
      <li>Your Instagram account must be a <strong>professional account</strong> (Business or Creator).</li>
      <li>In the Instagram app: Settings → Messages and story replies → Message controls → Connected tools →
        switch on <strong>Allow access to messages</strong>.</li>
      <li>Log in with the destination's Instagram account and allow all requested permissions.</li>
    </ul>
  </section>

  <section class="card">
    <ConnectCodeField />
    <button id="start" type="button">Connect with Instagram</button>
    <div id="status" class="status" hidden></div>
  </section>
</ConnectLayout>

<script>
  import { getConnectCode, isValidConnectCode, rememberConnectCode, instagramAuthorizeUrl, setStatus } from '../../lib/connect';

  const input = document.getElementById('connect-code') as HTMLInputElement;
  const button = document.getElementById('start') as HTMLButtonElement;
  const status = document.getElementById('status') as HTMLElement;
  input.value = getConnectCode();

  button.addEventListener('click', () => {
    const code = input.value.trim();
    if (!isValidConnectCode(code)) {
      setStatus(status, 'error', 'Please enter the 32-character connection code from DM2find.');
      return;
    }
    rememberConnectCode(code);
    button.disabled = true;
    location.href = instagramAuthorizeUrl(code);
  });
</script>
