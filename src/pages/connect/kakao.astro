---
import ConnectLayout from '../../layouts/ConnectLayout.astro';
import ConnectCodeField from '../../components/ConnectCodeField.astro';
---
<ConnectLayout title="Connect KakaoTalk">
  <h1>Connect KakaoTalk</h1>
  <p class="lead">Let the AI Travel Concierge answer your destination's KakaoTalk Channel (카카오톡 채널) through a Kakao i Open Builder chatbot — with menu, maps and availability.</p>

  <section class="card">
    <h2>1. Channel and chatbot</h2>
    <ol>
      <li>Create a KakaoTalk Channel for your destination in <a href="https://business.kakao.com" target="_blank" rel="noopener">Kakao Business</a> (or use your existing channel).</li>
      <li>Open <a href="https://chatbot.kakao.com" target="_blank" rel="noopener">Kakao i Open Builder</a>, create a chatbot and connect it to the channel (설정 → 카카오톡 채널 연결).</li>
    </ol>
  </section>

  <section class="card">
    <h2>2. Get your skill URL</h2>
    <form id="form" autocomplete="off">
      <ConnectCodeField />
      <button id="submit" type="submit">Create my Kakao skill URL</button>
    </form>
    <div id="status" class="status" hidden></div>
    <div id="skill" hidden>
      <label for="skill-url">Skill URL (keep it private)</label>
      <input id="skill-url" type="text" readonly />
      <button id="copy" type="button">Copy</button>
    </div>
  </section>

  <section class="card">
    <h2>3. Set up the chatbot</h2>
    <ol>
      <li><strong>스킬 (Skills) → 생성</strong>: name <em>DM2find</em>, URL = your skill URL. Save.</li>
      <li><strong>시나리오 → 폴백 블록</strong> (fallback block): under <strong>스킬 선택</strong> choose <em>DM2find</em>, set the bot response to <strong>스킬데이터 사용</strong> (use skill data).</li>
      <li>In the same block: <strong>⋯ → 콜백 설정</strong> (Callback API) → on, with a short waiting text. Searches can take longer than Kakao's 5-second limit; the callback delivers the full answer. The callback is only offered after Kakao approves the bot as an AI chatbot: <strong>설정 → AI 챗봇 관리 → AI 챗봇 전환</strong>. Request it first; until it is approved, menus and languages work but long searches may time out.</li>
      <li>Do the same for the <strong>웰컴 블록</strong> (welcome block).</li>
      <li><strong>배포</strong> (Deploy). Callbacks only work in the deployed bot, not in the test panel.</li>
    </ol>
    <p>Then add your channel as a friend, choose a language and ask a question. Type <em>menu</em> or <em>메뉴</em> for the menu.</p>
  </section>
</ConnectLayout>

<script>
  import { N8N_WEBHOOK_BASE, getConnectCode, isValidConnectCode, rememberConnectCode, postJson, setStatus } from '../../lib/connect';
  import type { ConnectResult } from '../../lib/connect';

  const KAKAO_ENDPOINT = `${N8N_WEBHOOK_BASE}/connect-kakao`;
  const form = document.getElementById('form') as HTMLFormElement;
  const codeInput = document.getElementById('connect-code') as HTMLInputElement;
  const button = document.getElementById('submit') as HTMLButtonElement;
  const status = document.getElementById('status') as HTMLElement;
  const skillBox = document.getElementById('skill') as HTMLElement;
  const skillUrl = document.getElementById('skill-url') as HTMLInputElement;
  const copyBtn = document.getElementById('copy') as HTMLButtonElement;
  codeInput.value = getConnectCode();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const connect_code = codeInput.value.trim();
    if (!isValidConnectCode(connect_code)) {
      setStatus(status, 'error', 'Please enter the 32-character connection code from DM2find.');
      return;
    }
    rememberConnectCode(connect_code);
    button.disabled = true;
    setStatus(status, 'busy', 'Creating your skill URL…');
    const r = (await postJson(KAKAO_ENDPOINT, { connect_code })) as ConnectResult & { skill_url?: string };
    button.disabled = false;
    if (r.success && r.skill_url) {
      skillUrl.value = r.skill_url;
      skillBox.hidden = false;
      setStatus(status, 'ok', `Skill URL ready for ${r.name ?? 'your destination'}`, 'Paste it in Open Builder (step 3). DM2find has been notified.');
    } else {
      setStatus(status, 'error', 'Could not create the skill URL.', r.message ?? '');
    }
  });

  copyBtn.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(skillUrl.value); copyBtn.textContent = 'Copied'; }
    catch { skillUrl.select(); }
  });
</script>
