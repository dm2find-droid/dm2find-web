---
import ConnectLayout from '../../layouts/ConnectLayout.astro';
import ConnectCodeField from '../../components/ConnectCodeField.astro';
---
<ConnectLayout title="Connect Facebook Messenger">
  <h1>Connect Facebook Messenger</h1>
  <p class="lead">Visitors who message your destination's Facebook Page get instant answers from your AI Travel Concierge.</p>

  <section class="card">
    <h2>Before you start</h2>
    <ul>
      <li>Log in to Facebook with an account that has <strong>full admin access</strong> to your destination's Page.</li>
      <li>In the Facebook window, select <strong>only your destination's Page</strong> and allow all requested permissions.</li>
      <li>Messaging must be switched on for the Page (Page settings → Messaging).</li>
    </ul>
  </section>

  <section class="card">
    <ConnectCodeField />
    <button id="start" type="button">Connect with Facebook</button>
    <div id="status" class="status" hidden></div>
  </section>
</ConnectLayout>

<script>
  import { getConnectCode, isValidConnectCode, rememberConnectCode, facebookAuthorizeUrl, setStatus } from '../../lib/connect';

  const input = document.getElementById('connect-code') as HTMLInputElement;
  const button = document.getElementById('start') as HTMLButtonElement;
  const status = document.getElementById('status') as HTMLElement;
  input.value = getConnectCode();

  button.addEventListener('click', () => {
    const code = input.value.trim();
    if (!isValidConnectCode(code)) {
      setStatus(status, 'error', 'Please enter the 32-character connection code from DM2find.');
      return;
    }
    rememberConnectCode(code);
    button.disabled = true;
    location.href = facebookAuthorizeUrl(code);
  });
</script>
