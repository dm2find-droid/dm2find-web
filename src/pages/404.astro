---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="mx-auto max-w-3xl px-5 py-20 text-center">
    <h1 class="h-display">Not here.</h1>
    <p class="lede mx-auto mt-5">That page moved when we rebuilt the site.</p>
    <a href="/destinations" class="mt-7 inline-block rounded-full bg-(--color-pine) px-6 py-3 font-semibold text-white">Browse destinations →</a>
  </section>
</Base>
