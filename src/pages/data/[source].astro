---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { linkAttrs } from '../../lib/link';
import DestinationCard from '../../components/DestinationCard.astro';

export async function getStaticPaths() {
  const sources = await getCollection('sources');
  const dests = (await getCollection('destinations')).map(e => e.data);
  return sources.map(s => ({
    params: { source: s.data.id },
    props: { s: s.data, dests: dests.filter(d => d.dataSource === s.data.id) },
  }));
}
const { s, dests } = Astro.props;
const connected = s.status === 'connected';
---
<Base title={s.name} angle="nto" description={`${s.name} — ${s.geo}. How DM2find connects to it.`}>
  <section class="mx-auto max-w-4xl px-5 py-12">
    <nav class="text-sm text-(--color-ink-3)"><a href="/platform">Data platform</a> → {s.name}</nav>
    <h1 class="h-display mt-4">{s.name}</h1>
    <p class="lede mt-4">{s.geo}. {connected
      ? 'Connected — we read this feed, and destinations published to it launch in 48 hours.'
      : 'Connector planned. Destinations in this geography currently run on public sources, and we do not claim attribution to this platform until the connector is live.'}</p>

    {connected && s.attributionRequired && (
      <div class="mt-6 rounded-xl border border-(--color-line) bg-white p-5">
        <h2 class="text-sm font-semibold">Attribution as published</h2>
        <p class="mt-2 text-sm italic text-(--color-ink-2)">{s.attribution}</p>
        <p class="mt-2 text-xs text-(--color-ink-3)">Rendered on every destination page sourced from this platform.</p>
      </div>
    )}
    {s.url && <p class="mt-4 text-sm"><a class="text-(--color-terra) underline" href={s.url} {...linkAttrs(s.url)}>{s.url}</a></p>}

    <h2 class="h-section mt-12">{dests.length} destination{dests.length === 1 ? '' : 's'}</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">{dests.map(d => <DestinationCard d={d} />)}</div>
  </section>
</Base>
