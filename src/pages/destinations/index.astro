---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DestinationCard from '../../components/DestinationCard.astro';

const all = (await getCollection('destinations')).map(e => e.data)
  .sort((a, b) => a.name.en.localeCompare(b.name.en));
const sources = Object.fromEntries((await getCollection('sources')).map(e => [e.data.id, e.data]));
const countries = [...new Set(all.map(d => d.countryName))].sort();
const channels  = [...new Set(all.flatMap(d => d.channels))].sort();
---
<Base title="Destinations" description="Every destination with a live concierge, and the data platform behind it.">
  <section class="mx-auto max-w-6xl px-5 py-12">
    <h1 class="h-display">Destinations</h1>
    <p class="lede mt-4">
      Every destination here is a concierge you can open and use right now — no request form, no waiting
      for a call back. Where it runs on an official platform we say so; where it runs on public sources
      we say that too.
    </p>

    <div class="mt-8 rounded-xl border border-(--color-line) bg-white px-5 py-2">
      <div class="flex flex-wrap items-start gap-2 border-b border-(--color-line-2) py-3">
        <span class="w-24 pt-2 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Country</span>
        <div class="flex flex-1 flex-wrap gap-1.5">
          <button class="f-chip" data-k="country" data-v="All">All</button>
          {countries.map(c => <button class="f-chip" data-k="country" data-v={c}>{c}</button>)}
        </div>
      </div>
      <div class="flex flex-wrap items-start gap-2 border-b border-(--color-line-2) py-3">
        <span class="w-24 pt-2 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Channel</span>
        <div class="flex flex-1 flex-wrap gap-1.5">
          <button class="f-chip" data-k="channel" data-v="All">All</button>
          {channels.map(c => <button class="f-chip" data-k="channel" data-v={c}>{c}</button>)}
        </div>
      </div>
      <div class="flex flex-wrap items-start gap-2 py-3">
        <span class="w-24 pt-2 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Data</span>
        <div class="flex flex-1 flex-wrap gap-1.5">
          <button class="f-chip" data-k="prov" data-v="All">All</button>
          <button class="f-chip" data-k="prov" data-v="official">Official feed</button>
          <button class="f-chip" data-k="prov" data-v="preview">Public sources</button>
        </div>
      </div>
    </div>

    <p id="count" class="mt-5 text-sm text-(--color-ink-3)"></p>
    <div id="grid" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {all.map(d => (
        <div class="d-item" data-country={d.countryName} data-prov={d.provenance} data-channel={d.channels.join('|')}>
          <DestinationCard d={d} />
        </div>
      ))}
    </div>
  </section>

  <style is:global>
    .f-chip { border:1px solid var(--color-line); background:#fff; border-radius:9999px;
      padding:.45rem .85rem; font-size:.83rem; color:var(--color-ink-2); cursor:pointer }
    .f-chip[data-on] { background:var(--color-ink); color:#fff; border-color:var(--color-ink) }
  </style>
  <script>
    const F: Record<string,string> = { country:'All', channel:'All', prov:'All' };
    const chips = document.querySelectorAll<HTMLElement>('.f-chip');
    const items = document.querySelectorAll<HTMLElement>('.d-item');
    const count = document.getElementById('count')!;
    const paint = () => {
      chips.forEach(c => {
        const on = F[c.dataset.k!] === c.dataset.v;
        on ? c.setAttribute('data-on','') : c.removeAttribute('data-on');
      });
      let n = 0;
      items.forEach(i => {
        const ok = (F.country==='All' || i.dataset.country===F.country)
                && (F.prov==='All'    || i.dataset.prov===F.prov)
                && (F.channel==='All' || (i.dataset.channel||'').split('|').includes(F.channel));
        i.style.display = ok ? '' : 'none'; if (ok) n++;
      });
      count.textContent = `${n} destination${n===1?'':'s'}`;
    };
    chips.forEach(c => c.addEventListener('click', () => { F[c.dataset.k!] = c.dataset.v!; paint(); }));
    paint();
  </script>
</Base>
