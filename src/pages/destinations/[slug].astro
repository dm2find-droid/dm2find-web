---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chat from '../../components/Chat.astro';
import ProvenanceBadge from '../../components/ProvenanceBadge.astro';
import DestinationCard from '../../components/DestinationCard.astro';

export async function getStaticPaths() {
  const dests = await getCollection('destinations');
  const sources = Object.fromEntries((await getCollection('sources')).map(e => [e.data.id, e.data]));
  return dests.map(e => ({
    params: { slug: e.data.slug },
    props: {
      d: e.data,
      source: e.data.dataSource ? sources[e.data.dataSource] : null,
      siblings: dests.filter(x => x.data.country === e.data.country && x.data.slug !== e.data.slug)
                     .slice(0, 3).map(x => x.data),
    },
  }));
}
const { d, source, siblings } = Astro.props;
const official = d.provenance === 'official';

/* Attribution renders ONLY where the data genuinely came from that source.
   Rendering it for a preview destination would be a false attribution claim. */
const attribution = official && source?.attributionRequired ? source.attribution : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: d.name.en,
  url: new URL(`/destinations/${d.slug}`, Astro.site).href,
  ...(official && source ? { isBasedOn: { '@type': 'Dataset', name: source.name } } : {}),
};
---
<Base title={`Ask anything about ${d.name.en}`} angle="traveller" jsonLd={jsonLd}
      description={official
        ? `Ask anything about ${d.name.en}. Answers from ${d.countryName}'s own tourism data via ${source?.name}.`
        : `A live concierge for ${d.name.en}, answering from data compiled from public sources.`}>
  <section class="mx-auto max-w-6xl px-5 pt-8 pb-12">
    <nav class="text-sm text-(--color-ink-3)">
      <a href="/">Home</a> → <a href="/destinations">Destinations</a> →
      <a href={`/countries/${d.country.toLowerCase()}`}>{d.countryName}</a> → {d.name.en}
    </nav>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <h1 class="h-display">Ask anything about {d.name.en}</h1>
      <ProvenanceBadge provenance={d.provenance} sourceName={official ? source?.name : undefined} />
    </div>
    <p class="lede mt-4">
      {official
        ? `Answers from ${d.countryName}'s own tourism data via ${source?.name}, refreshed daily — and filled in by the businesses themselves. Free, no account.`
        : `Live now for ${d.name.en}, answering from data we compile from public sources. Ask it anything — then see below what changes when ${d.countryName}'s official platform is connected.`}
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <Chat name={d.name.en} chatUrl={d.chatUrl} />
        {!official && (
          <div class="mt-4 rounded-xl border border-(--color-amber) bg-(--color-amber-l) px-4 py-3.5 text-sm text-(--color-ink-2)">
            <b>Running on public sources.</b> This concierge is live and answering, but {d.name.en} isn’t yet
            connected to an official tourism data platform — so coverage is broad rather than complete, and it
            doesn’t refresh itself. Connecting the official feed fixes both, in 48 hours.
            <a href="/dmo" class="font-semibold text-(--color-amber)"> If you market {d.name.en}, talk to us →</a>
          </div>
        )}
      </div>

      <aside class="space-y-4">
        <div class="rounded-xl border border-(--color-line) bg-white p-5">
          <h2 class="text-sm font-semibold">Where this comes from</h2>
          <p class="mt-2 text-sm text-(--color-ink-2)">
            {official ? source?.name : 'Public web sources'}
          </p>
          <p class="mt-1 text-xs text-(--color-ink-3)">
            {official ? 'Synchronised continuously' : 'Compiled — not continuously refreshed'}
          </p>
          {attribution && <p class="mt-3 text-xs italic text-(--color-ink-3)">{attribution}</p>}
        </div>

        <div class="rounded-xl border border-(--color-line) bg-white p-5">
          <h2 class="text-sm font-semibold">Also reachable on</h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {d.channels.map(c => (
              <span class="rounded-full bg-(--color-paper-3) px-3 py-1 text-xs font-semibold">{c}</span>
            ))}
          </div>
          {d.voiceId && <p class="mt-3 text-xs text-(--color-ink-3)">Voice demo: <code>{d.voiceId}</code></p>}
        </div>

        <div class="rounded-xl border border-(--color-amber) bg-(--color-amber-l) p-5">
          <h2 class="text-sm font-semibold">Own a business here?</h2>
          <p class="mt-2 text-sm text-(--color-ink-2)">
            You’re likely already listed. Claim it and add your photos, features and booking link.
          </p>
          <a href="/business" class="mt-3 inline-block rounded-full bg-(--color-amber) px-4 py-2 text-sm font-semibold text-white">
            Claim your listing
          </a>
        </div>
      </aside>
    </div>

    {siblings.length > 0 && (
      <>
        <h2 class="h-section mt-14">More in {d.countryName}</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {siblings.map(s => <DestinationCard d={s} />)}
        </div>
      </>
    )}
  </section>
</Base>
