---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chat from '../../components/Chat.astro';
import VoiceDemo from '../../components/VoiceDemo.astro';
import VenueCard from '../../components/VenueCard.astro';
import { linkAttrs } from '../../lib/link';

export async function getStaticPaths() {
  const venues = await getCollection('venues');
  return venues.map(e => ({
    params: { slug: e.data.slug },
    props: {
      v: e.data,
      siblings: venues.filter(x => x.data.industry === e.data.industry && x.data.slug !== e.data.slug)
                      .slice(0, 3).map(x => x.data),
    },
  }));
}
const { v, siblings } = Astro.props;

const LABEL: Record<string, string> = {
  golf_resort: 'Golf club', hospitality: 'Restaurant', mixed_property: 'Resort',
};
const SCHEMA: Record<string, string> = {
  golf_resort: 'GolfCourse', hospitality: 'Restaurant', mixed_property: 'Resort',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': SCHEMA[v.industry],
  name: v.name,
  url: new URL(`/venues/${v.slug}`, Astro.site).href,
  ...(v.website ? { sameAs: v.website } : {}),
  ...(v.coords ? { geo: { '@type': 'GeoCoordinates', latitude: v.coords[0], longitude: v.coords[1] } } : {}),
  address: { '@type': 'PostalAddress', addressCountry: v.country, ...(v.city ? { addressLocality: v.city } : {}) },
};
---
<Base title={`Ask ${v.name} anything`} angle="business" jsonLd={jsonLd}
      description={`A live concierge for ${v.name} — ${LABEL[v.industry].toLowerCase()} in ${v.countryName}.`}>
  <section class="mx-auto max-w-6xl px-5 pt-8 pb-12">
    <nav class="text-sm text-(--color-ink-3)">
      <a href="/">Home</a> → <a href="/venues">Venues</a> → {v.name}
    </nav>

    <div class="mt-5 flex flex-wrap items-center gap-4">
      {v.logo && (
        <img src={v.logo} alt={`${v.name} logo`} width="56" height="56" loading="lazy"
             class="h-14 w-14 rounded-xl border border-(--color-line) bg-white object-contain p-1.5" />
      )}
      <h1 class="h-display">Ask {v.name} anything</h1>
      <span class="rounded-full bg-(--color-paper-3) px-3 py-1 text-xs font-semibold text-(--color-ink-2)">
        {LABEL[v.industry]}
      </span>
    </div>
    <p class="lede mt-4">
      {[v.city, v.region, v.countryName].filter(Boolean).join(' · ')}. This concierge answers for this
      property alone — hours, rules, what is on, and what it costs. No form, no account.
    </p>

    <div class="mt-8 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <Chat name={v.name} chatUrl={v.chatUrl} />

        {v.voiceAgentId && (
          <div class="mt-6">
            <div class="flex items-center gap-2">
              <h2 class="text-sm font-semibold">Or just talk to it</h2>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-(--color-pine-l) px-2.5 py-0.5 text-[11px] font-semibold text-(--color-pine)">
                <span class="h-1.5 w-1.5 rounded-full bg-current"></span> Live voice demo
              </span>
            </div>
            <div class="mt-3"><VoiceDemo agentId={v.voiceAgentId} place={v.name} /></div>
          </div>
        )}
      </div>

      <aside class="space-y-4">
        <div class="rounded-xl border border-(--color-line) bg-white p-5">
          <h2 class="text-sm font-semibold">Booking</h2>
          {v.booking === 'panel' && (
            <>
              <p class="mt-2 text-sm text-(--color-ink-2)">
                Ask it for a date and a party size and it reads this venue's own reservation system.
              </p>
              <p class="mt-2 text-xs text-(--color-ink-3)">
                We show availability; the booking itself is completed with the venue. No payment passes
                through us and no commission is charged.
              </p>
            </>
          )}
          {v.booking === 'link' && (
            <>
              <p class="mt-2 text-sm text-(--color-ink-2)">This venue books on its own platform.</p>
              <a href={v.bookingUrl} {...linkAttrs(v.bookingUrl)}
                 class="mt-3 inline-block rounded-full bg-(--color-pine) px-4 py-2 text-sm font-semibold text-white">
                Book direct →
              </a>
            </>
          )}
          {v.booking === 'none' && (
            <p class="mt-2 text-sm text-(--color-ink-2)">
              Ask the concierge and it will point you to the right place to reserve.
            </p>
          )}
        </div>

        <div class="rounded-xl border border-(--color-line) bg-white p-5">
          <h2 class="text-sm font-semibold">Reachable on</h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {v.channels.map((c: string) => (
              <span class="rounded-full bg-(--color-paper-3) px-3 py-1 text-xs font-semibold">{c}</span>
            ))}
          </div>
          {v.website && (
            <a href={v.website} {...linkAttrs(v.website)}
               class="mt-3 inline-block text-sm font-semibold text-(--color-pine) underline">
              Official website →
            </a>
          )}
        </div>

        <div class="rounded-xl border border-(--color-pine) bg-(--color-pine-l) p-5">
          <h2 class="text-sm font-semibold">Run a venue like this?</h2>
          <p class="mt-2 text-sm text-(--color-ink-2)">
            A concierge of your own, on your site and on WhatsApp, reading the systems you already run.
          </p>
          <a href="/pricing#venues" class="mt-3 inline-block rounded-full bg-(--color-pine) px-4 py-2 text-sm font-semibold text-white">
            What it costs
          </a>
        </div>
      </aside>
    </div>
  </section>

  {siblings.length > 0 && (
    <section class="border-t border-(--color-line-2) bg-(--color-paper-2) py-12">
      <div class="mx-auto max-w-6xl px-5">
        <h2 class="h-section">More {LABEL[v.industry].toLowerCase()}s</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {siblings.map((s: any) => <VenueCard v={s} />)}
        </div>
      </div>
    </section>
  )}
</Base>
