---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VenueCard from '../../components/VenueCard.astro';

const all = (await getCollection('venues')).map(e => e.data)
  .sort((a, b) => a.name.localeCompare(b.name));

const LABEL: Record<string, string> = {
  golf_resort: 'Golf club', hospitality: 'Restaurant', mixed_property: 'Resort',
};
const industries = [...new Set(all.map(v => v.industry))]
  .sort((a, b) => LABEL[a].localeCompare(LABEL[b]));
const countries = [...new Set(all.map(v => v.countryName))].sort();

/* Same folding as /destinations: accents must never block a match. */
const fold = (s: string) => (s ?? '').normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
const key = (v: any) => [v.name, v.city, v.countryName, v.region, v.slug, LABEL[v.industry]]
  .filter(Boolean).map(fold).join(' ');

const withBooking = all.filter(v => v.booking !== 'none').length;
const withVoice = all.filter(v => v.voiceAgentId).length;
---
<Base title="Venues" angle="business"
      description="Hotels, golf clubs, restaurants and resorts running their own DM2find concierge.">
  <section class="mx-auto max-w-6xl px-5 py-12">
    <p class="mb-3 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Venues</p>
    <h1 class="h-display">A concierge of their own.</h1>
    <p class="lede mt-4">
      Not destinations, but single properties: a golf club, a restaurant, a resort. Each answers for
      itself — its own opening hours, its own rules, its own kitchen — and {withBooking} of
      them can check live availability while you are still in the conversation.
    </p>

    <div class="relative mt-8">
      <svg class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-(--color-ink-3)"
           width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
        <path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <input id="q" type="search" autocomplete="off" enterkeyhint="go"
             placeholder="Start typing — Gleneagles, Coque, Terre Blanche…"
             aria-label="Search venues"
             class="w-full rounded-xl border border-(--color-line) bg-white py-3.5 pr-4 pl-11 text-base
                    outline-none placeholder:text-(--color-ink-3) focus:border-(--color-pine)" />
    </div>

    <div class="mt-3 rounded-xl border border-(--color-line) bg-white px-5 py-2">
      <div class="flex flex-wrap items-start gap-2 border-b border-(--color-line-2) py-3">
        <span class="w-24 pt-2 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Type</span>
        <div class="flex flex-1 flex-wrap gap-1.5">
          <button class="f-chip" data-k="ind" data-v="All">All</button>
          {industries.map(i => <button class="f-chip" data-k="ind" data-v={i}>{LABEL[i]}</button>)}
        </div>
      </div>
      <div class="flex flex-wrap items-start gap-2 border-b border-(--color-line-2) py-3">
        <span class="w-24 pt-2 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Country</span>
        <div class="flex flex-1 flex-wrap gap-1.5">
          <button class="f-chip" data-k="country" data-v="All">All</button>
          {countries.map(c => <button class="f-chip" data-k="country" data-v={c}>{c}</button>)}
        </div>
      </div>
      <div class="flex flex-wrap items-start gap-2 py-3">
        <span class="w-24 pt-2 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Shows</span>
        <div class="flex flex-1 flex-wrap gap-1.5">
          <button class="f-chip" data-k="shows" data-v="All">All</button>
          <button class="f-chip" data-k="shows" data-v="booking">Availability</button>
          <button class="f-chip" data-k="shows" data-v="voice">Voice demo</button>
        </div>
      </div>
    </div>

    <p id="count" class="mt-5 text-sm text-(--color-ink-3)"></p>
    <div id="grid" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {all.map(v => (
        <div class="v-item" data-country={v.countryName} data-ind={v.industry}
             data-booking={v.booking} data-voice={v.voiceAgentId ? '1' : ''} data-k={key(v)}>
          <VenueCard v={v} />
        </div>
      ))}
    </div>
    <div id="empty" class="mt-6 hidden rounded-xl border border-(--color-line) bg-white p-8 text-center">
      <p class="font-semibold">Nothing matches that.</p>
      <p class="mt-1.5 text-sm text-(--color-ink-2)">Try the country instead of the town.</p>
      <button id="reset" class="mt-4 rounded-full bg-(--color-pine) px-5 py-2.5 text-sm font-semibold text-white">
        Clear search and filters
      </button>
    </div>

    <div class="mt-10 rounded-xl border border-(--color-line) bg-(--color-paper-2) p-6">
      <h2 class="text-sm font-semibold">What "availability" means here</h2>
      <p class="mt-2 max-w-[74ch] text-sm text-(--color-ink-2)">
        We read the venue's own reservation system and show what is free. <b>We do not take the
        booking</b> — no payment, no inventory held, no commission on the table or the green fee. The
        visitor finishes at the venue's own checkout. {withVoice} of these venues can also be asked out
        loud.
      </p>
      <a href="/platform#booking" class="mt-3 inline-block text-sm font-semibold text-(--color-pine) underline">
        Which systems we read →
      </a>
    </div>
  </section>

  <style is:global>
    .f-chip { border:1px solid var(--color-line); background:#fff; border-radius:9999px;
      padding:.45rem .85rem; font-size:.83rem; color:var(--color-ink-2); cursor:pointer }
    .f-chip[data-on] { background:var(--color-ink); color:#fff; border-color:var(--color-ink) }
  </style>
  <script>
    const F: Record<string,string> = { ind:'All', country:'All', shows:'All' };
    const chips = document.querySelectorAll<HTMLElement>('.f-chip');
    const items = document.querySelectorAll<HTMLElement>('.v-item');
    const count = document.getElementById('count')!;
    const empty = document.getElementById('empty')!;
    const q     = document.getElementById('q') as HTMLInputElement;
    const fold  = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();
    let visible: HTMLElement[] = [];

    const paint = () => {
      chips.forEach(c => {
        const on = F[c.dataset.k!] === c.dataset.v;
        on ? c.setAttribute('data-on','') : c.removeAttribute('data-on');
      });
      const words = fold(q.value).split(/\s+/).filter(Boolean);
      visible = [];
      items.forEach(i => {
        const ok = (F.ind==='All'     || i.dataset.ind===F.ind)
                && (F.country==='All' || i.dataset.country===F.country)
                && (F.shows==='All'   || (F.shows==='voice' ? i.dataset.voice==='1'
                                                            : i.dataset.booking!=='none'))
                && words.every(w => (i.dataset.k||'').includes(w));
        i.style.display = ok ? '' : 'none';
        if (ok) visible.push(i);
      });
      const n = visible.length;
      count.textContent = n ? `${n} venue${n===1?'':'s'}` : '';
      empty.classList.toggle('hidden', n > 0);
    };

    chips.forEach(c => c.addEventListener('click', () => { F[c.dataset.k!] = c.dataset.v!; paint(); }));
    q.addEventListener('input', paint);
    q.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { q.value = ''; paint(); }
      if (e.key === 'Enter' && visible.length === 1) {
        const a = visible[0].querySelector('a');
        if (a) window.location.href = a.getAttribute('href')!;
      }
    });
    document.getElementById('reset')!.addEventListener('click', () => {
      q.value = ''; F.ind = F.country = F.shows = 'All'; paint(); q.focus();
    });
    paint();
  </script>
</Base>
