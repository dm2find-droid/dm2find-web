---
/** fr / de / nl / es. Engels heeft geen prefix en staat in
 *  /destinations/[slug].astro. */
import Base from '../../../layouts/Base.astro';
import DestinationBody from '../../../components/DestinationBody.astro';
import { destinationProps } from '../../../lib/pageData';
import { t, LOCALES, DEFAULT_LOCALE, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const rows = await destinationProps();
  return LOCALES.filter(l => l !== DEFAULT_LOCALE).flatMap(locale =>
    rows.map(r => ({ params: { locale, slug: r.slug }, props: { ...r.props, locale } })),
  );
}
const { d, source, siblings, curatedCount, locale } = Astro.props as any;
const _ = t(locale as Locale);
const official = d.provenance === 'official';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: d.name.en,
  url: new URL(`/${locale}/destinations/${d.slug}`, Astro.site).href,
  inLanguage: locale,
  ...(official && source ? { isBasedOn: { '@type': 'Dataset', name: source.name } } : {}),
};
---
<Base title={_('dest.title', { place: d.name.en })} angle="traveller" jsonLd={jsonLd}
      description={official
        ? _('dest.meta.official', { place: d.name.en, country: d.countryName, source: source?.name ?? '' })
        : _('dest.meta.preview', { place: d.name.en })}>
  <DestinationBody d={d} source={source} siblings={siblings} curatedCount={curatedCount} locale={locale} />
</Base>
