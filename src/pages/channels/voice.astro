</Base>

<style>
  .vd-pick[aria-pressed='true'] { border-color: var(--color-terra); background: var(--color-terra-l); }
  .vc-lang[aria-pressed='true'] { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }

  .vc-orb {
    background: var(--color-terra);
    box-shadow: 0 0 0 0 rgb(192 86 47 / .35);
    transition: transform .2s ease, background-color .25s ease;
    cursor: pointer;
  }
  .vc-orb-eu { background: var(--color-slate2); }
  .vc-orb:active { transform: scale(.97); }
  .vc-orb[data-state='idle']       { animation: vc-invite 2.6s ease-in-out infinite; }
  .vc-orb[data-state='connecting'] { opacity: .75; animation: vc-pulse 1.2s ease-in-out infinite; cursor: progress; }
  .vc-orb[data-state='listening']  { animation: vc-pulse 2.4s ease-in-out infinite; cursor: default; }
  .vc-orb[data-state='speaking']   { background: var(--color-pine); animation: vc-pulse .9s ease-in-out infinite; cursor: default; }
  .vc-orb[data-state='error']      { background: var(--color-amber); }

  @keyframes vc-invite {
    0%, 100% { box-shadow: 0 0 0 0 rgb(192 86 47 / .32); }
    50%      { box-shadow: 0 0 0 20px rgb(192 86 47 / 0); }
  }
  @keyframes vc-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.05); }
  }
  @media (prefers-reduced-motion: reduce) { .vc-orb { animation: none !important; } }
</style>

<script is:inline type="module">
  /* is:inline, bewust: Vite herschrijft een dynamische import() naar zijn eigen
     preload-helper, en die bestaat niet in een inline script. Zo blijft het een
     gewone browser-import die pas bij de eerste tik iets ophaalt.

     Zelfde lazy-load-afspraak als VoiceDemo.astro: niets van ElevenLabs wordt
     geladen tot iemand op de orb tikt. `gen` maakt elke sessie uniek, zodat een
     late onDisconnect van een vorige sessie (taal- of bestemmingswissel) de
     nieuwe niet terugzet naar idle. */
  const data = JSON.parse(document.getElementById('vc-data').textContent || '{}');
  const SDK = 'https://esm.sh/@elevenlabs/client';

  const el = (id) => document.getElementById(id);
  const orb = el('vc-orb'), statusEl = el('vc-status'), endBtn = el('vc-end'), panel = el('vc');
  const nameEl = el('vc-name'), levelEl = el('vc-level'), pageEl = el('vc-page');
  const picks = [...document.querySelectorAll('.vd-pick')];
  const langBtns = [...document.querySelectorAll('.vc-lang')];

  let current = data.demos[0];
  const pref = (navigator.language || 'en').slice(0, 2).toLowerCase();
  let lang = data.langs.includes(pref) ? pref : 'en';
  let convo = null;
  let gen = 0;

  const TEXT = {
    idle: 'Tap to talk to the AI', connecting: 'Connecting…', listening: 'Listening…', speaking: 'AI speaking…',
  };
  function setState(state, text) {
    orb.dataset.state = state;
    statusEl.textContent = text ?? TEXT[state] ?? '';
    const inCall = state === 'connecting' || state === 'listening' || state === 'speaking';
    endBtn.hidden = !inCall;
    orb.setAttribute('aria-label', inCall ? 'Conversation with the AI in progress' : 'Start talking to the AI');
  }
  function markPick() {
    picks.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.key === current.slug)));
    nameEl.textContent = current.name;
    levelEl.textContent = `${current.level} · ${current.country}`;
    pageEl.hidden = !current.href;
    if (current.href) pageEl.href = current.href;
    // Taalknoppen alleen voor agents met language override; dan alleen de talen die die agent spreekt.
    const hasLangs = current.langs.length > 0;
    el('vc-langs').hidden = !hasLangs;
    langBtns.forEach(b => { b.hidden = !current.langs.includes(b.dataset.lang); });
    if (hasLangs && !current.langs.includes(lang)) { lang = current.langs.includes('en') ? 'en' : current.langs[0]; markLang(); }
  }
  function markLang() {
    langBtns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.lang === lang)));
  }

  async function end() {
    gen++;
    const c = convo; convo = null;
    try { await c?.endSession?.(); } catch {}
    setState('idle');
  }

  // Agents die de taal-override weigeren (staat in ElevenLabs uit): daar starten we voortaan zonder.
  const noOverride = new Set();

  /* Agents met "Enable authentication" weigeren een sessie met alleen agentId (401).
     Voor die agents halen we eerst een kortlevend token bij onze eigen route; die houdt
     de API-sleutel op de server en kent alleen tenants met web_voice_enabled. Geeft de
     route geen token (andere demo's, route onbereikbaar), dan valt de pagina terug op
     agentId zoals voorheen. */
  const TOKEN_API = 'https://chat.dm2find.ai/api/voice/token?tenant=';
  async function getToken(slug) {
    try {
      const r = await fetch(TOKEN_API + encodeURIComponent(slug), { cache: 'no-store' });
      if (!r.ok) return null;
      const d = await r.json();
      return typeof d?.token === 'string' && d.token ? d.token : null;
    } catch { return null; }
  }

  async function start(retry = false) {
    if (convo || (!retry && orb.dataset.state === 'connecting')) return;
    const my = ++gen;
    const slug = current.slug;
    const useOverride = current.langs.length > 0 && !noOverride.has(slug);
    const t0 = Date.now();
    let spoke = false;
    /* Weigert een agent de override, dan valt de sessie binnen enkele seconden weg
       zonder dat de agent iets heeft gezegd. Dan één keer opnieuw zonder override:
       de bezoeker merkt hooguit een korte vertraging, en de agent herkent de taal
       nog steeds aan wat de bezoeker zegt. */
    const fellBack = () => {
      if (!useOverride || spoke || Date.now() - t0 > 6000) return false;
      noOverride.add(slug);
      convo = null;
      start(true);
      return true;
    };
    setState('connecting');
    if (!retry) {
      try {
        const mic = await navigator.mediaDevices.getUserMedia({ audio: true });
        mic.getTracks().forEach(t => t.stop());   // alleen toestemming vragen; de SDK opent zijn eigen stream
      } catch {
        if (my === gen) setState('error', 'Microphone blocked. Allow it in your browser, then tap again.');
        return;
      }
    }
    try {
      const { Conversation } = await import(SDK);
      if (my !== gen) return;
      const token = await getToken(slug);
      if (my !== gen) return;
      const c = await Conversation.startSession({
        ...(token ? { conversationToken: token } : { agentId: current.agentId }),
        connectionType: 'webrtc',
        ...(useOverride ? { overrides: { agent: { language: lang } } } : {}),
        onConnect: () => { if (my === gen) setState('listening'); },
        onDisconnect: () => {
          if (my !== gen || fellBack()) return;
          convo = null; setState('idle');
        },
        onError: (e) => {
          console.error(e);
          if (my !== gen || fellBack()) return;
          convo = null; setState('error', 'Something went wrong. Tap to try again.');
        },
        onModeChange: (m) => {
          if (my !== gen) return;
          if (m?.mode === 'speaking') spoke = true;
          setState(m?.mode === 'speaking' ? 'speaking' : 'listening');
        },
      });
      if (my !== gen) { try { await c.endSession(); } catch {} return; }
      convo = c;
    } catch (e) {
      console.error(e);
      if (my !== gen || fellBack()) return;
      setState('error', 'Could not connect. Tap to try again.');
    }
  }

  orb.addEventListener('click', () => { if (!convo) start(); });
  endBtn.addEventListener('click', end);

  picks.forEach(b => b.addEventListener('click', async () => {
    const next = data.demos.find(d => d.slug === b.dataset.key);
    if (!next) return;
    if (next.slug !== current.slug && (convo || orb.dataset.state !== 'idle')) await end();
    current = next;
    markPick();
    if (window.matchMedia('(max-width: 1023px)').matches) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));

  langBtns.forEach(b => b.addEventListener('click', async () => {
    const was = !!convo;
    lang = b.dataset.lang || 'en';
    markLang();
    if (was) { await end(); start(); }
  }));

  window.addEventListener('pagehide', () => { try { convo?.endSession?.(); } catch {} });

  markPick();
  markLang();
</script>

<script is:inline type="module">
  /* De Europese demo (LiveKit + Gradium + Mistral), live voor Strasbourg.
     Los van het ElevenLabs-script hierboven: een fout hier raakt de andere demo's niet.
     De LiveKit-client staat als eigen bestand op deze site (/vendor/), dus er wordt
     niets van een externe CDN geladen; hij wordt pas opgehaald bij de eerste tik.
     Het token komt van de chat-app (alleen tenants met voice_provider = livekit). */
  const LK_SDK = '/vendor/livekit-client-2.23.0.esm.mjs';
  const TOKEN_API = 'https://chat.dm2find.ai/api/voice-token';
  /* De bestemming komt uit de keuzelijst; wisselen tijdens een gesprek beëindigt het. */
  const pick = document.getElementById('eu-pick');
  const langsEl = document.getElementById('eu-langs');
  const TENANT = () => (pick && pick.value) || 'strasbourg-eu';
  const MAX_MS = 5 * 60 * 1000;     // vangnet tegen vergeten sessies (kosten)
  const JOIN_MS = 20 * 1000;        // de agent moet binnen 20 s aansluiten

  const orb = document.getElementById('eu-orb');
  const statusEl = document.getElementById('eu-status');
  const endBtn = document.getElementById('eu-end');
  if (orb && statusEl && endBtn) {
    let room = null, gen = 0, joinTimer = null, maxTimer = null;
    const audioEls = new Set();
    const TEXT = { idle: 'Tap to talk to the AI', connecting: 'Connecting…', listening: 'Listening…', speaking: 'AI speaking…' };

    function setState(state, text) {
      orb.dataset.state = state;
      statusEl.textContent = text ?? TEXT[state] ?? '';
      const inCall = state === 'connecting' || state === 'listening' || state === 'speaking';
      endBtn.hidden = !inCall;
      orb.setAttribute('aria-label', inCall ? 'Conversation with the AI in progress' : 'Start the European AI voice demo');
    }

    function teardown() {
      clearTimeout(joinTimer); clearTimeout(maxTimer);
      joinTimer = null; maxTimer = null;
      audioEls.forEach(a => a.remove());
      audioEls.clear();
      const r = room; room = null;
      if (r) { r.removeAllListeners(); try { r.disconnect(); } catch {} }
    }

    async function end(text) {
      gen++;
      teardown();
      setState('idle', text);
    }

    async function getToken() {
      const r = await fetch(TOKEN_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tenant: TENANT(), ui: 'voice' }),
        cache: 'no-store',
      });
      if (!r.ok) throw new Error('token_' + r.status);
      const d = await r.json();
      if (!d?.token || !d?.url) throw new Error('no_token');
      return d;
    }

    async function start() {
      if (room || orb.dataset.state === 'connecting') return;
      const my = ++gen;
      setState('connecting');
      try {
        const mic = await navigator.mediaDevices.getUserMedia({ audio: true });
        mic.getTracks().forEach(t => t.stop());   // alleen toestemming vragen; de SDK opent zijn eigen stream
      } catch {
        if (my === gen) setState('error', 'Microphone blocked. Allow it in your browser, then tap again.');
        return;
      }
      try {
        const [lk, tok] = await Promise.all([import(LK_SDK), getToken()]);
        if (my !== gen) return;
        const { Room, RoomEvent, Track, ParticipantKind } = lk;
        const r = new Room({ audioCaptureDefaults: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });
        room = r;
        let agentSeen = false;
        const live = () => {
          agentSeen = true;
          clearTimeout(joinTimer); joinTimer = null;
          if (my === gen) setState('listening');
        };
        r.on(RoomEvent.TrackSubscribed, (track) => {
          if (track.kind !== Track.Kind.Audio) return;
          const a = track.attach();
          a.style.display = 'none';
          document.body.appendChild(a);
          audioEls.add(a);
        });
        r.on(RoomEvent.TrackUnsubscribed, (track) => {
          track.detach().forEach(a => { audioEls.delete(a); a.remove(); });
        });
        r.on(RoomEvent.ParticipantConnected, (p) => { if (p.kind === ParticipantKind.AGENT) live(); });
        r.on(RoomEvent.ActiveSpeakersChanged, (speakers) => {
          if (my !== gen || !agentSeen) return;
          setState(speakers.some(s => s.identity !== r.localParticipant.identity) ? 'speaking' : 'listening');
        });
        r.on(RoomEvent.Disconnected, () => {
          if (my !== gen) return;
          teardown();
          setState('idle');
        });

        await r.connect(tok.url, tok.token);
        if (my !== gen) return;                   // end() ruimde al op
        await r.startAudio().catch(() => {});     // afspelen is ontgrendeld door de tik die het gesprek startte
        await r.localParticipant.setMicrophoneEnabled(true);
        if (my !== gen) return;

        if ([...r.remoteParticipants.values()].some(p => p.kind === ParticipantKind.AGENT)) {
          live();
        } else {
          joinTimer = setTimeout(() => {
            if (my !== gen || agentSeen) return;
            gen++; teardown();
            setState('error', 'The European demo is not available right now. Please try again later.');
          }, JOIN_MS);
        }
        maxTimer = setTimeout(() => {
          if (my === gen) end('Call ended after 5 minutes. Tap to talk to the AI again.');
        }, MAX_MS);
      } catch (e) {
        console.error(e);
        if (my !== gen) return;
        gen++; teardown();
        setState('error', 'Could not connect. Tap to try again.');
      }
    }

    orb.addEventListener('click', () => { if (!room) start(); });
    endBtn.addEventListener('click', () => end());
    if (pick) pick.addEventListener('change', () => {
      const o = pick.selectedOptions[0];
      if (langsEl && o) langsEl.textContent = `Starts in ${o.dataset.main} · ${o.dataset.n} languages, switch by speaking`;
      if (room || orb.dataset.state === 'connecting') end();
    });
    window.addEventListener('pagehide', () => { try { room?.disconnect(); } catch {} });
    setState('idle');
  }
</script>
