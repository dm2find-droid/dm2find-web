---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { BOOKING_URL, SALES_EMAIL } from '../../data/site';
import ChannelsNav from '../../components/ChannelsNav.astro';
import sources from '../../data/sources.json';

/* Live spraakdemo's. Volgorde (okt. 2026): eerst de volledig Europese keten,
   daarna de internationale demo's op ElevenLabs (VS).

   Wélke ElevenLabs-demo's er staan, komt uit destinations.json: elke bestemming met een
   voiceAgentId (= el_agent_id in de tenants-tabel) verschijnt hier vanzelf.
   Deze lijst voegt alleen toe wat de data niet weet:
   - FEATURED: de Franse demo's, bovenaan en in deze volgorde, met taalknoppen.
   - DESC:     één regel per kaart (de Engelse tagline uit de tenants-tabel).
   - LEVEL:    alleen als het geen stad is.
   - LANGS:    standaard alle talen; zie LANGS_BY_SLUG voor uitzonderingen.

   Wat een kaart over de databron zegt (officiële feed of publieke bronnen, en
   wélke feed) komt uit destinations.json + sources.json, nooit uit deze lijst.
   Zo claimt een demo op publieke bronnen (Brugge, Amsterdam) of op Open Data
   Germany van de DZT (München) nooit per ongeluk "DATAtourisme". */
const FEATURED = ['paris', 'nancy', 'strasbourg', 'lyon', 'pau', 'pyrenees-atlantiques', 'nouvelle-aquitaine'];

const DESC: Record<string, string> = {
  'paris':                'The capital. Everyone knows it, so you can check every answer.',
  'nancy':                'Place Stanislas (UNESCO) and Art Nouveau.',
  'strasbourg':           'Cathedral, canals, Christmas markets and Alsace cuisine.',
  'lyon':                 'Bouchons, traboules and a serious food scene.',
  'pau':                  'Pyrenees views from the boulevard, the Gave, Jurançon wine.',
  'pyrenees-atlantiques': 'Bayonne, Biarritz, the Basque coast and the Béarn: all of the 64.',
  'nouvelle-aquitaine':   'Twelve départements, from Bordeaux to the Pyrenees, in one assistant.',
  'amsterdam':            'Canals, Rijksmuseum, cycling.',
  'beijing':              'Imperial palaces, street food, hutongs.',
  'berlin':               'Berlin Wall, techno clubs, museums.',
  'bruges':               'Medieval canals, the Belfry, chocolate.',
  'busan':                'Oceanfront beaches, seafood markets, skyline views.',
  'damascus':             'The old souk, the Umayyad Mosque, Damascus steel.',
  'den-bosch':            'Historic centre, St John\'s Cathedral, canals.',
  'girona':               'Medieval old town, tapas, riverside walks.',
  'granada':              'The Alhambra, tapas, views from the Albaicín.',
  'groningen-province':   'Wadden coast, Hanseatic towns, cycling and the city of Groningen.',
  'hamburg':              'Elbe harbour, Speicherstadt, Reeperbahn.',
  'hong-kong':            'Skyline views, street food, harbour ferries.',
  'innsbruck':            'Alpine views, Nordkette hiking, old town.',
  'istanbul':             'The Bosphorus, bazaars and two continents.',
  'kyoto':                'Historic temples, geisha streets, kaiseki cuisine.',
  'luxembourg-city':      'The Alzette, the old town, the casemates.',
  'monaco':               'Formula One, Monte Carlo, sea views.',
  'munich':               'Oktoberfest, beer gardens, the English Garden.',
  'new-york-city':        'Broadway shows, skyline views, delis.',
  'seville':              'Giralda views, tapas alleys, flamenco.',
  'singapore':            'Hawker centres, Marina Bay, gardens.',
  'taipei':               'Night markets, Taipei 101, hot pot.',
  'trento':               'Alpine views, historic centre, cycling.',
  'turin':                'Mole Antonelliana, cafés, markets.',
  'utrecht':              'Canals, the Dom Tower, cycling, cafés.',
  'zagreb':               'Historic Upper Town, museums, cafés.',
  'zurich':               'Lake Zürich, Bahnhofstrasse, museums.',
  'gothenburg':            'Canals, the harbour, seafood, parks.',
  'helsinki':              'Baltic harbour, design, saunas.',
  'merano':                'Thermal spas, mountain hikes, promenades.',
  'bologna':               'Porticoes, ragù, university life.',
  'montreal':              'Old Montréal, festivals, Mount Royal, bagels.',
  'bayonne':               'Basque food, the old town, riverside strolls.',
  'bearn-des-gaves':       'Salies-de-Béarn, Sauveterre and the gaves: rivers, salt and rafting.',
  'coeur-de-bearn':        'Orthez, Navarrenx and the Béarn countryside.',
  'haut-bearn':            'Oloron-Sainte-Marie and the Aspe and Barétous valleys.',
  'lourdes':               'Grotto sanctuary, Lourdes spring, processions.',
  'pays-basque':           'Biarritz, Bayonne, Saint-Jean-de-Luz and the Basque hinterland.',
  'vallee-d-ossau':        'High Pyrenees: Pic du Midi d\'Ossau, lakes, mountain villages.',
};
const LEVEL: Record<string, string> = {
  'pyrenees-atlantiques': 'Département',
  'nouvelle-aquitaine':   'Region',
  'groningen-province':   'Province',
  'pays-basque':           'Territory',
  'bearn-des-gaves':       'Territory',
  'coeur-de-bearn':        'Territory',
  'haut-bearn':            'Territory',
  'vallee-d-ossau':        'Territory',
};

/* Starttaal van het gesprek. Labels in de eigen taal, geen vlaggen: Windows
   toont vlag-emoji als losse letters, en een taal is geen land. */
const LANGS = [
  ['fr', 'Français'], ['en', 'English'], ['nl', 'Nederlands'], ['de', 'Deutsch'],
  ['es', 'Español'], ['it', 'Italiano'], ['zh', '中文'], ['ja', '日本語'],
] as const;
const ALL_LANGS: string[] = LANGS.map(([c]) => c);
/* Elke agent krijgt de taalknoppen. Alleen een uitzondering hier zetten als een
   agent minder talen moet tonen, bv. 'munich': ['de', 'en']. Staat de override in
   ElevenLabs bij een agent (nog) uit, dan valt de pagina vanzelf terug op een
   sessie zonder override; zie start() hieronder. */
const LANGS_BY_SLUG: Record<string, string[]> = {};

const SOURCE = new Map((sources as { id: string; name: string }[]).map(x => [x.id, x.name]));
const and = (xs: string[]) => xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;

const all = (await getCollection('destinations')).map(e => e.data).filter(x => !!x.voiceAgentId);
for (const f of FEATURED) {
  if (!all.some(x => x.slug === f)) throw new Error(`/channels/voice: featured demo "${f}" has no voiceAgentId in destinations.json`);
}
const rank = (slug: string) => { const k = FEATURED.indexOf(slug); return k === -1 ? Infinity : k; };
const demos = all
  .map(x => ({
    slug: x.slug,
    name: x.name?.en ?? x.slug,
    agentId: x.voiceAgentId as string,
    level: LEVEL[x.slug] ?? 'City',
    desc: DESC[x.slug] ?? '',
    langs: LANGS_BY_SLUG[x.slug] ?? ALL_LANGS,
    logo: x.logo ?? null,
    href: `/destinations/${x.slug}`,
    country: x.countryName,
    provenance: x.provenance,
    sourceName: x.dataSource ? (SOURCE.get(x.dataSource) ?? null) : null,
  }))
  .sort((a, b) => rank(a.slug) - rank(b.slug) || a.name.localeCompare(b.name, 'en'));

/* Groepen per land: Frankrijk eerst (daar staan de uitgewerkte demo's), daarna
   alfabetisch. */
const first = demos[0];
const countries = [...new Set(demos.map(d => d.country))]
  .sort((a, b) => (a === first.country ? -1 : b === first.country ? 1 : a.localeCompare(b, 'en')));
const groups = countries.map(c => ({
  title: c,
  id: 'c-' + c.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
  items: demos.filter(d => d.country === c),
}));

/* De bronnenzin bij de ElevenLabs-demo's, afgeleid uit wat die demo's werkelijk gebruiken. */
const feeds = [...new Set(demos.filter(d => d.provenance === 'official' && d.sourceName).map(d => d.sourceName as string))];
const hasPublic = demos.some(d => d.provenance === 'preview');
const sourceSentence = and([
  ...(feeds.length ? [`official open-data feeds (${and(feeds)})`] : []),
  ...(hasPublic ? ['public sources'] : []),
]);
const names = demos.map(d => d.name);
const metaNames = names.length > 7 ? `${names.slice(0, 6).join(', ')} and more` : and(names);
/* De volledig Europese spraakketen. Alleen wat echt draait, met waar het draait —
   dezelfde regel als de keten op /platform. Gradium alleen als EU-endpoint
   (eu.api.gradium.ai) in de worker staat; zie de handleiding. */
const EU_CHAIN = [
  { k: 'Speech to text',   what: 'Gradium speech recognition',                 who: 'Gradium',                  where: 'EU endpoint' },
  { k: 'Language model',   what: 'Mistral Small 3.2',                          who: 'Scaleway',                 where: 'Paris, FR' },
  { k: 'Destination data', what: "Our search over the destination's own data", who: 'Our own servers, Hetzner', where: 'Germany' },
  { k: 'Text to speech',   what: 'Gradium voice synthesis',                    who: 'Gradium',                  where: 'EU endpoint' },
  { k: 'Real-time audio',  what: 'LiveKit, open source WebRTC',                who: 'Our own servers, Hetzner', where: 'Germany' },
];
const euMail = `mailto:${SALES_EMAIL}?subject=${encodeURIComponent('Demo: fully European voice')}`;
---
<Base title="Voice demos" angle="dmo"
      description={`Talk to a destination. A fully European voice assistant, plus live demos on ElevenLabs for ${metaNames}, right in your browser.`}>
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-8">
    <ChannelsNav />
    <p class="mb-3 text-xs font-bold tracking-widest text-(--color-terra) uppercase">Voice · live demo</p>
    <h1 class="h-display">Talk to a destination.</h1>
    <p class="lede mt-5">
      Ask out loud and hear the answer, from the open tourism data published for that destination:
      events, opening hours, restaurants, trails. Start with our fully European voice stack, or try the
      international one for more destinations and languages.
    </p>
    <p class="mt-3 max-w-[60ch] text-sm text-(--color-ink-3)">
      A destination's name and logo show which place the assistant covers; they do not mean the tourist
      office is a customer.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#eu-voice" class="rounded-full bg-(--color-slate2) px-5 py-2.5 text-sm font-semibold text-white transition hover:brightness-110">
        Fully European ↓
      </a>
      <a href="#demos" class="rounded-full border border-(--color-line) bg-white px-5 py-2.5 text-sm font-semibold text-(--color-ink) transition hover:border-(--color-ink-3)">
        International demos ↓
      </a>
    </div>
    <ul class="mt-6 flex flex-wrap gap-2 text-xs font-semibold text-(--color-ink-2)">
      <li class="rounded-full border border-(--color-line) bg-white px-3 py-1">European or international voice stack</li>
      <li class="rounded-full border border-(--color-line) bg-white px-3 py-1">In the browser, no app</li>
      <li class="rounded-full border border-(--color-line) bg-white px-3 py-1">Microphone only after you tap</li>
    </ul>
  </section>

  <section id="eu-voice" class="scroll-mt-20 border-t border-(--color-line-2) py-14">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 lg:grid-cols-[1fr_1.35fr] lg:items-start">
      <div>
        <p class="mb-3 text-xs font-bold tracking-widest text-(--color-slate2) uppercase">Fully European · EU sovereignty</p>
        <h2 class="h-section">The whole conversation,<br />inside Europe.</h2>
        <p class="mt-4 text-(--color-ink-2)">
          Our European voice stack keeps every step of the conversation in the EU: European speech
          technology for listening and speaking, Mistral for the answers, and our own servers for the data
          and the audio. No US cloud anywhere in the chain.
        </p>
        <p class="mt-3 text-(--color-ink-2)">
          For tourist offices that want visitor conversations to stay under European rules, this is the
          stack to start from.
        </p>
        <p class="mt-3 text-sm text-(--color-ink-3)">Try it live for Strasbourg, on open data from DATAtourisme. French today, more languages on request.</p>

        <div id="eu" class="mt-6 flex items-center gap-5 rounded-2xl border border-(--color-line) bg-white p-5">
          <button id="eu-orb" type="button" data-state="idle" aria-label="Start the European voice demo"
                  class="vc-orb vc-orb-eu grid h-24 w-24 shrink-0 place-items-center rounded-full text-white">
            <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="3" width="6" height="11" rx="3" />
              <path d="M5 11a7 7 0 0 0 14 0M12 18v3M8.5 21h7" />
            </svg>
          </button>
          <div class="min-w-0 text-left">
            <p class="text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Live · Strasbourg</p>
            <p id="eu-status" class="mt-1 min-h-6 text-base font-semibold" aria-live="polite">Tap to talk</p>
            <button id="eu-end" type="button" hidden
                    class="mt-2 rounded-full border border-(--color-slate2) px-4 py-1.5 text-sm font-semibold text-(--color-slate2) transition hover:bg-(--color-slate2-l)">
              End call
            </button>
          </div>
        </div>

        <a href={euMail} class="mt-5 inline-flex text-sm font-semibold text-(--color-slate2) underline underline-offset-2 hover:brightness-110">
          Talk to us about the European option
        </a>
      </div>
      <ol class="grid gap-3 sm:grid-cols-2">
        {EU_CHAIN.map((c, i) => (
          <li class="rounded-2xl border border-(--color-line) bg-white p-5">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold tracking-wider text-(--color-ink-3) uppercase">{i + 1} · {c.k}</span>
              <span class="rounded-full bg-(--color-pine-l) px-2.5 py-0.5 text-[11px] font-semibold text-(--color-pine)">EU</span>
            </div>
            <p class="mt-2 font-semibold text-(--color-ink)">{c.what}</p>
            <p class="mt-1 text-sm text-(--color-ink-2)">{c.who} · {c.where}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="demos" class="scroll-mt-20 border-t border-(--color-line-2) py-14">
    <div class="mx-auto max-w-6xl px-5">
    <div class="mb-8 max-w-[68ch]">
      <p class="mb-3 text-xs font-bold tracking-widest text-(--color-terra) uppercase">International · ElevenLabs (US)</p>
      <h2 class="h-section">More destinations, almost any language.</h2>
      <p class="mt-4 text-(--color-ink-2)">
        These demos run on ElevenLabs, a US provider. In return they cover more destinations, and they
        understand and answer in almost any language, switching when you do.
      </p>
      <p class="mt-3 text-sm text-(--color-ink-3)">
        Live data from {sourceSentence}; each card shows which.
        Need every step in Europe? <a href="#eu-voice" class="font-semibold text-(--color-slate2) underline underline-offset-2">Use the European version ↑</a>
      </p>
    </div>
    <div class="grid items-start gap-8 lg:grid-cols-[1.15fr_1fr]">
      <div>
        {groups.length > 2 && (
          <nav aria-label="Countries" class="mb-6 flex flex-wrap gap-1.5">
            {groups.map(g => (
              <a href={`#${g.id}`} class="rounded-full border border-(--color-line) bg-white px-3 py-1 text-xs text-(--color-ink-2) transition hover:border-(--color-ink-3) hover:text-(--color-ink)">
                {g.title} <span class="text-(--color-ink-3)">{g.items.length}</span>
              </a>
            ))}
          </nav>
        )}
        {groups.map(g => (
          <div id={g.id} class="mb-8 scroll-mt-24 last:mb-0">
            <h3 class="mb-3 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase" style="font-family:var(--font-sans)">{g.title}</h3>
            <div class="grid gap-3 sm:grid-cols-2">
              {g.items.map(d => (
                <button type="button" data-key={d.slug} aria-pressed={d.slug === first.slug ? 'true' : 'false'}
                        class="vd-pick flex items-start gap-3 rounded-2xl border border-(--color-line) bg-white p-4 text-left transition hover:border-(--color-terra)">
                  {d.logo
                    ? <img src={d.logo} alt="" width="44" height="44" loading="lazy"
                           class="h-11 w-11 shrink-0 rounded-lg border border-(--color-line-2) bg-white object-contain" />
                    : <span class="h-11 w-11 shrink-0 rounded-lg bg-(--color-paper-2)"></span>}
                  <span class="min-w-0">
                    {d.level !== 'City' && <span class="block text-[11px] font-bold tracking-wider text-(--color-terra) uppercase">{d.level}</span>}
                    <span class="block font-serif text-lg leading-tight font-semibold">{d.name}</span>
                    {d.desc && <span class="mt-1 block text-sm text-(--color-ink-2)">{d.desc}</span>}
                    {/* Zelfde kleuren als ProvenanceBadge, maar kort genoeg voor een smalle kaart:
                        alleen de bronnaam, de volledige uitleg zit in de title. */}
                    {d.provenance && (
                      <span title={d.provenance === 'official' ? `Official feed${d.sourceName ? ` · ${d.sourceName}` : ''}` : 'Public sources'}
                            class={`mt-2 inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${
                              d.provenance === 'official' ? 'bg-(--color-pine-l) text-(--color-pine)' : 'bg-(--color-amber-l) text-(--color-amber)'}`}>
                        <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                        {d.provenance === 'official' ? (d.sourceName ?? 'Official feed') : 'Public sources'}
                      </span>
                    )}
                  </span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div id="vc" class="scroll-mt-20 rounded-2xl border border-(--color-line) bg-white p-6 text-center lg:sticky lg:top-24">
        <p class="text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">You are talking to</p>
        <h3 id="vc-name" class="h-section mt-1">{first.name}</h3>
        <p id="vc-level" class="mt-1 text-sm text-(--color-ink-3)">{first.level} · {first.country}</p>

        {/* Geldt voor álle agents: ze herkennen de taal van de spreker en wisselen mee. */}
        <div class="mt-5 inline-flex items-center gap-2 rounded-full bg-(--color-pine-l) px-3.5 py-1.5 text-sm font-semibold text-(--color-pine)">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" />
          </svg>
          Just speak your own language
        </div>
        <p class="mx-auto mt-2 max-w-[34ch] text-xs text-(--color-ink-3)">
          It understands and answers in almost any language, and switches when you do.
        </p>

        <div id="vc-langs" hidden={first.langs.length === 0}>
          <p class="mt-4 mb-2 text-xs text-(--color-ink-3)">Or pick the language it opens in</p>
          <div class="flex flex-wrap justify-center gap-1.5">
            {LANGS.map(([code, label]) => (
              <button type="button" data-lang={code} lang={code} aria-pressed="false"
                      class="vc-lang rounded-full border border-(--color-line) px-3 py-1.5 text-sm text-(--color-ink-2) transition hover:border-(--color-ink-3)">
                {label}
              </button>
            ))}
          </div>
        </div>

        <button id="vc-orb" type="button" data-state="idle" aria-label="Start talking"
                class="vc-orb mx-auto mt-7 grid h-40 w-40 place-items-center rounded-full text-white">
          <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="3" width="6" height="11" rx="3" />
            <path d="M5 11a7 7 0 0 0 14 0M12 18v3M8.5 21h7" />
          </svg>
        </button>
        <p id="vc-status" class="mt-5 min-h-7 text-lg font-semibold" aria-live="polite">Tap to talk</p>
        <button id="vc-end" type="button" hidden
                class="mt-3 rounded-full border border-(--color-terra) px-5 py-2 text-sm font-semibold text-(--color-terra) transition hover:bg-(--color-terra-l)">
          End call
        </button>
        <a id="vc-page" href={first.href ?? '#'} hidden={!first.href}
           class="mx-auto mt-4 block w-fit text-xs text-(--color-ink-2) underline underline-offset-2 hover:text-(--color-ink)">
          Destination page and webchat →
        </a>
      </div>
    </div>
    </div>
  </section>

  <section class="border-t border-(--color-line-2) bg-(--color-paper-2) py-12">
    <div class="mx-auto grid max-w-6xl items-center gap-6 px-5 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="h-section">Voice for your destination</h2>
        <p class="mt-3 text-(--color-ink-2)">
          The same assistant as your webchat, with the same data and the same answers, now spoken. Fully
          European or international, from a single city to a whole region, in the browser, on the phone or
          through WhatsApp.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        <a href={BOOKING_URL} target="_blank" rel="noopener"
           class="rounded-full bg-(--color-pine) px-5 py-2.5 text-sm font-semibold text-white transition hover:brightness-110">
          Book a walkthrough
        </a>
        <a href="/channels" class="rounded-full border border-(--color-line) bg-white px-5 py-2.5 text-sm font-semibold text-(--color-ink) transition hover:border-(--color-ink-3)">
          All channels
        </a>
      </div>
    </div>
  </section>

  <script is:inline type="application/json" id="vc-data" set:html={JSON.stringify({
    demos: demos.map(({ slug, name, level, country, agentId, href, langs }) => ({ slug, name, level, country, agentId, href, langs })),
    langs: ALL_LANGS,
  })} />
</Base>

<style>
  .vd-pick[aria-pressed='true'] { border-color: var(--color-terra); background: var(--color-terra-l); }
  .vc-lang[aria-pressed='true'] { background: var(--color-ink); border-color: var(--color-ink); color: #fff; }

  .vc-orb {
    background: var(--color-terra);
    box-shadow: 0 0 0 0 rgb(192 86 47 / .35);
    transition: transform .2s ease, background-color .25s ease;
    cursor: pointer;
  }
  .vc-orb-eu { background: var(--color-slate2); }
  .vc-orb:active { transform: scale(.97); }
  .vc-orb[data-state='idle']       { animation: vc-invite 2.6s ease-in-out infinite; }
  .vc-orb[data-state='connecting'] { opacity: .75; animation: vc-pulse 1.2s ease-in-out infinite; cursor: progress; }
  .vc-orb[data-state='listening']  { animation: vc-pulse 2.4s ease-in-out infinite; cursor: default; }
  .vc-orb[data-state='speaking']   { background: var(--color-pine); animation: vc-pulse .9s ease-in-out infinite; cursor: default; }
  .vc-orb[data-state='error']      { background: var(--color-amber); }

  @keyframes vc-invite {
    0%, 100% { box-shadow: 0 0 0 0 rgb(192 86 47 / .32); }
    50%      { box-shadow: 0 0 0 20px rgb(192 86 47 / 0); }
  }
  @keyframes vc-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.05); }
  }
  @media (prefers-reduced-motion: reduce) { .vc-orb { animation: none !important; } }
</style>

<script is:inline type="module">
  /* is:inline, bewust: Vite herschrijft een dynamische import() naar zijn eigen
     preload-helper, en die bestaat niet in een inline script. Zo blijft het een
     gewone browser-import die pas bij de eerste tik iets ophaalt.

     Zelfde lazy-load-afspraak als VoiceDemo.astro: niets van ElevenLabs wordt
     geladen tot iemand op de orb tikt. `gen` maakt elke sessie uniek, zodat een
     late onDisconnect van een vorige sessie (taal- of bestemmingswissel) de
     nieuwe niet terugzet naar idle. */
  const data = JSON.parse(document.getElementById('vc-data').textContent || '{}');
  const SDK = 'https://esm.sh/@elevenlabs/client';

  const el = (id) => document.getElementById(id);
  const orb = el('vc-orb'), statusEl = el('vc-status'), endBtn = el('vc-end'), panel = el('vc');
  const nameEl = el('vc-name'), levelEl = el('vc-level'), pageEl = el('vc-page');
  const picks = [...document.querySelectorAll('.vd-pick')];
  const langBtns = [...document.querySelectorAll('.vc-lang')];

  let current = data.demos[0];
  const pref = (navigator.language || 'en').slice(0, 2).toLowerCase();
  let lang = data.langs.includes(pref) ? pref : 'en';
  let convo = null;
  let gen = 0;

  const TEXT = {
    idle: 'Tap to talk', connecting: 'Connecting…', listening: 'Listening…', speaking: 'Speaking…',
  };
  function setState(state, text) {
    orb.dataset.state = state;
    statusEl.textContent = text ?? TEXT[state] ?? '';
    const inCall = state === 'connecting' || state === 'listening' || state === 'speaking';
    endBtn.hidden = !inCall;
    orb.setAttribute('aria-label', inCall ? 'Conversation in progress' : 'Start talking');
  }
  function markPick() {
    picks.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.key === current.slug)));
    nameEl.textContent = current.name;
    levelEl.textContent = `${current.level} · ${current.country}`;
    pageEl.hidden = !current.href;
    if (current.href) pageEl.href = current.href;
    // Taalknoppen alleen voor agents met language override; dan alleen de talen die die agent spreekt.
    const hasLangs = current.langs.length > 0;
    el('vc-langs').hidden = !hasLangs;
    langBtns.forEach(b => { b.hidden = !current.langs.includes(b.dataset.lang); });
    if (hasLangs && !current.langs.includes(lang)) { lang = current.langs.includes('en') ? 'en' : current.langs[0]; markLang(); }
  }
  function markLang() {
    langBtns.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.lang === lang)));
  }

  async function end() {
    gen++;
    const c = convo; convo = null;
    try { await c?.endSession?.(); } catch {}
    setState('idle');
  }

  // Agents die de taal-override weigeren (staat in ElevenLabs uit): daar starten we voortaan zonder.
  const noOverride = new Set();

  /* Agents met "Enable authentication" weigeren een sessie met alleen agentId (401).
     Voor die agents halen we eerst een kortlevend token bij onze eigen route; die houdt
     de API-sleutel op de server en kent alleen tenants met web_voice_enabled. Geeft de
     route geen token (andere demo's, route onbereikbaar), dan valt de pagina terug op
     agentId zoals voorheen. */
  const TOKEN_API = 'https://chat.dm2find.ai/api/voice/token?tenant=';
  async function getToken(slug) {
    try {
      const r = await fetch(TOKEN_API + encodeURIComponent(slug), { cache: 'no-store' });
      if (!r.ok) return null;
      const d = await r.json();
      return typeof d?.token === 'string' && d.token ? d.token : null;
    } catch { return null; }
  }

  async function start(retry = false) {
    if (convo || (!retry && orb.dataset.state === 'connecting')) return;
    const my = ++gen;
    const slug = current.slug;
    const useOverride = current.langs.length > 0 && !noOverride.has(slug);
    const t0 = Date.now();
    let spoke = false;
    /* Weigert een agent de override, dan valt de sessie binnen enkele seconden weg
       zonder dat de agent iets heeft gezegd. Dan één keer opnieuw zonder override:
       de bezoeker merkt hooguit een korte vertraging, en de agent herkent de taal
       nog steeds aan wat de bezoeker zegt. */
    const fellBack = () => {
      if (!useOverride || spoke || Date.now() - t0 > 6000) return false;
      noOverride.add(slug);
      convo = null;
      start(true);
      return true;
    };
    setState('connecting');
    if (!retry) {
      try {
        const mic = await navigator.mediaDevices.getUserMedia({ audio: true });
        mic.getTracks().forEach(t => t.stop());   // alleen toestemming vragen; de SDK opent zijn eigen stream
      } catch {
        if (my === gen) setState('error', 'Microphone blocked. Allow it in your browser, then tap again.');
        return;
      }
    }
    try {
      const { Conversation } = await import(SDK);
      if (my !== gen) return;
      const token = await getToken(slug);
      if (my !== gen) return;
      const c = await Conversation.startSession({
        ...(token ? { conversationToken: token } : { agentId: current.agentId }),
        connectionType: 'webrtc',
        ...(useOverride ? { overrides: { agent: { language: lang } } } : {}),
        onConnect: () => { if (my === gen) setState('listening'); },
        onDisconnect: () => {
          if (my !== gen || fellBack()) return;
          convo = null; setState('idle');
        },
        onError: (e) => {
          console.error(e);
          if (my !== gen || fellBack()) return;
          convo = null; setState('error', 'Something went wrong. Tap to try again.');
        },
        onModeChange: (m) => {
          if (my !== gen) return;
          if (m?.mode === 'speaking') spoke = true;
          setState(m?.mode === 'speaking' ? 'speaking' : 'listening');
        },
      });
      if (my !== gen) { try { await c.endSession(); } catch {} return; }
      convo = c;
    } catch (e) {
      console.error(e);
      if (my !== gen || fellBack()) return;
      setState('error', 'Could not connect. Tap to try again.');
    }
  }

  orb.addEventListener('click', () => { if (!convo) start(); });
  endBtn.addEventListener('click', end);

  picks.forEach(b => b.addEventListener('click', async () => {
    const next = data.demos.find(d => d.slug === b.dataset.key);
    if (!next) return;
    if (next.slug !== current.slug && (convo || orb.dataset.state !== 'idle')) await end();
    current = next;
    markPick();
    if (window.matchMedia('(max-width: 1023px)').matches) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));

  langBtns.forEach(b => b.addEventListener('click', async () => {
    const was = !!convo;
    lang = b.dataset.lang || 'en';
    markLang();
    if (was) { await end(); start(); }
  }));

  window.addEventListener('pagehide', () => { try { convo?.endSession?.(); } catch {} });

  markPick();
  markLang();
</script>

<script is:inline type="module">
  /* De Europese demo (LiveKit + Gradium + Mistral), live voor Strasbourg.
     Los van het ElevenLabs-script hierboven: een fout hier raakt de andere demo's niet.
     De LiveKit-client staat als eigen bestand op deze site (/vendor/), dus er wordt
     niets van een externe CDN geladen; hij wordt pas opgehaald bij de eerste tik.
     Het token komt van de chat-app (alleen tenants met voice_provider = livekit). */
  const LK_SDK = '/vendor/livekit-client-2.23.0.esm.mjs';
  const TOKEN_API = 'https://chat.dm2find.ai/api/voice-token';
  const TENANT = 'strasbourg-eu';
  const MAX_MS = 5 * 60 * 1000;     // vangnet tegen vergeten sessies (kosten)
  const JOIN_MS = 20 * 1000;        // de agent moet binnen 20 s aansluiten

  const orb = document.getElementById('eu-orb');
  const statusEl = document.getElementById('eu-status');
  const endBtn = document.getElementById('eu-end');
  if (orb && statusEl && endBtn) {
    let room = null, gen = 0, joinTimer = null, maxTimer = null;
    const audioEls = new Set();
    const TEXT = { idle: 'Tap to talk', connecting: 'Connecting…', listening: 'Listening…', speaking: 'Speaking…' };

    function setState(state, text) {
      orb.dataset.state = state;
      statusEl.textContent = text ?? TEXT[state] ?? '';
      const inCall = state === 'connecting' || state === 'listening' || state === 'speaking';
      endBtn.hidden = !inCall;
      orb.setAttribute('aria-label', inCall ? 'Conversation in progress' : 'Start the European voice demo');
    }

    function teardown() {
      clearTimeout(joinTimer); clearTimeout(maxTimer);
      joinTimer = null; maxTimer = null;
      audioEls.forEach(a => a.remove());
      audioEls.clear();
      const r = room; room = null;
      if (r) { r.removeAllListeners(); try { r.disconnect(); } catch {} }
    }

    async function end(text) {
      gen++;
      teardown();
      setState('idle', text);
    }

    async function getToken() {
      const r = await fetch(TOKEN_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tenant: TENANT, ui: 'voice' }),
        cache: 'no-store',
      });
      if (!r.ok) throw new Error('token_' + r.status);
      const d = await r.json();
      if (!d?.token || !d?.url) throw new Error('no_token');
      return d;
    }

    async function start() {
      if (room || orb.dataset.state === 'connecting') return;
      const my = ++gen;
      setState('connecting');
      try {
        const mic = await navigator.mediaDevices.getUserMedia({ audio: true });
        mic.getTracks().forEach(t => t.stop());   // alleen toestemming vragen; de SDK opent zijn eigen stream
      } catch {
        if (my === gen) setState('error', 'Microphone blocked. Allow it in your browser, then tap again.');
        return;
      }
      try {
        const [lk, tok] = await Promise.all([import(LK_SDK), getToken()]);
        if (my !== gen) return;
        const { Room, RoomEvent, Track, ParticipantKind } = lk;
        const r = new Room({ audioCaptureDefaults: { echoCancellation: true, noiseSuppression: true, autoGainControl: true } });
        room = r;
        let agentSeen = false;
        const live = () => {
          agentSeen = true;
          clearTimeout(joinTimer); joinTimer = null;
          if (my === gen) setState('listening');
        };
        r.on(RoomEvent.TrackSubscribed, (track) => {
          if (track.kind !== Track.Kind.Audio) return;
          const a = track.attach();
          a.style.display = 'none';
          document.body.appendChild(a);
          audioEls.add(a);
        });
        r.on(RoomEvent.TrackUnsubscribed, (track) => {
          track.detach().forEach(a => { audioEls.delete(a); a.remove(); });
        });
        r.on(RoomEvent.ParticipantConnected, (p) => { if (p.kind === ParticipantKind.AGENT) live(); });
        r.on(RoomEvent.ActiveSpeakersChanged, (speakers) => {
          if (my !== gen || !agentSeen) return;
          setState(speakers.some(s => s.identity !== r.localParticipant.identity) ? 'speaking' : 'listening');
        });
        r.on(RoomEvent.Disconnected, () => {
          if (my !== gen) return;
          teardown();
          setState('idle');
        });

        await r.connect(tok.url, tok.token);
        if (my !== gen) return;                   // end() ruimde al op
        await r.startAudio().catch(() => {});     // afspelen is ontgrendeld door de tik die het gesprek startte
        await r.localParticipant.setMicrophoneEnabled(true);
        if (my !== gen) return;

        if ([...r.remoteParticipants.values()].some(p => p.kind === ParticipantKind.AGENT)) {
          live();
        } else {
          joinTimer = setTimeout(() => {
            if (my !== gen || agentSeen) return;
            gen++; teardown();
            setState('error', 'The European demo is not available right now. Please try again later.');
          }, JOIN_MS);
        }
        maxTimer = setTimeout(() => {
          if (my === gen) end('Call ended after 5 minutes. Tap to talk again.');
        }, MAX_MS);
      } catch (e) {
        console.error(e);
        if (my !== gen) return;
        gen++; teardown();
        setState('error', 'Could not connect. Tap to try again.');
      }
    }

    orb.addEventListener('click', () => { if (!room) start(); });
    endBtn.addEventListener('click', () => end());
    window.addEventListener('pagehide', () => { try { room?.disconnect(); } catch {} });
    setState('idle');
  }
</script>
