---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { BOOKING_URL, SALES_EMAIL } from '../../data/site';
import ChannelsNav from '../../components/ChannelsNav.astro';
import sources from '../../data/sources.json';
import { euVoiceOf, euVoiceStats, STT, TTS, LANG_NAME, UPDATED } from '../../lib/euVoice';

/* Live spraakdemo's. Volgorde (okt. 2026): eerst de volledig Europese keten,
   daarna de internationale demo's op ElevenLabs (VS).

   Wélke ElevenLabs-demo's er staan, komt uit destinations.json: elke bestemming met een
   voiceAgentId (= el_agent_id in de tenants-tabel) verschijnt hier vanzelf.
   Deze lijst voegt alleen toe wat de data niet weet:
   - FEATURED: de Franse demo's, bovenaan en in deze volgorde, met taalknoppen.
   - DESC:     één regel per kaart (de Engelse tagline uit de tenants-tabel).
   - LEVEL:    alleen als het geen stad is.
   - LANGS:    standaard alle talen; zie LANGS_BY_SLUG voor uitzonderingen.

   Wat een kaart over de databron zegt (officiële feed of publieke bronnen, en
   wélke feed) komt uit destinations.json + sources.json, nooit uit deze lijst.
   Zo claimt een demo op publieke bronnen (Brugge, Amsterdam) of op Open Data
   Germany van de DZT (München) nooit per ongeluk "DATAtourisme". */
const FEATURED = ['paris', 'nancy', 'strasbourg', 'lyon', 'pau', 'pyrenees-atlantiques', 'nouvelle-aquitaine'];

const DESC: Record<string, string> = {
  'paris':                'The capital. Everyone knows it, so you can check every answer.',
  'nancy':                'Place Stanislas (UNESCO) and Art Nouveau.',
  'strasbourg':           'Cathedral, canals, Christmas markets and Alsace cuisine.',
  'lyon':                 'Bouchons, traboules and a serious food scene.',
  'pau':                  'Pyrenees views from the boulevard, the Gave, Jurançon wine.',
  'pyrenees-atlantiques': 'Bayonne, Biarritz, the Basque coast and the Béarn: all of the 64.',
  'nouvelle-aquitaine':   'Twelve départements, from Bordeaux to the Pyrenees, in one assistant.',
  'amsterdam':            'Canals, Rijksmuseum, cycling.',
  'beijing':              'Imperial palaces, street food, hutongs.',
  'berlin':               'Berlin Wall, techno clubs, museums.',
  'bruges':               'Medieval canals, the Belfry, chocolate.',
  'busan':                'Oceanfront beaches, seafood markets, skyline views.',
  'damascus':             'The old souk, the Umayyad Mosque, Damascus steel.',
  'den-bosch':            'Historic centre, St John\'s Cathedral, canals.',
  'girona':               'Medieval old town, tapas, riverside walks.',
  'granada':              'The Alhambra, tapas, views from the Albaicín.',
  'groningen-province':   'Wadden coast, Hanseatic towns, cycling and the city of Groningen.',
  'hamburg':              'Elbe harbour, Speicherstadt, Reeperbahn.',
  'hong-kong':            'Skyline views, street food, harbour ferries.',
  'innsbruck':            'Alpine views, Nordkette hiking, old town.',
  'istanbul':             'The Bosphorus, bazaars and two continents.',
  'kyoto':                'Historic temples, geisha streets, kaiseki cuisine.',
  'luxembourg-city':      'The Alzette, the old town, the casemates.',
  'monaco':               'Formula One, Monte Carlo, sea views.',
  'munich':               'Oktoberfest, beer gardens, the English Garden.',
  'new-york-city':        'Broadway shows, skyline views, delis.',
  'seville':              'Giralda views, tapas alleys, flamenco.',
  'singapore':            'Hawker centres, Marina Bay, gardens.',
  'taipei':               'Night markets, Taipei 101, hot pot.',
  'trento':               'Alpine views, historic centre, cycling.',
  'turin':                'Mole Antonelliana, cafés, markets.',
  'utrecht':              'Canals, the Dom Tower, cycling, cafés.',
  'zagreb':               'Historic Upper Town, museums, cafés.',
  'zurich':               'Lake Zürich, Bahnhofstrasse, museums.',
  'gothenburg':            'Canals, the harbour, seafood, parks.',
  'helsinki':              'Baltic harbour, design, saunas.',
  'merano':                'Thermal spas, mountain hikes, promenades.',
  'bologna':               'Porticoes, ragù, university life.',
  'montreal':              'Old Montréal, festivals, Mount Royal, bagels.',
  'bayonne':               'Basque food, the old town, riverside strolls.',
  'bearn-des-gaves':       'Salies-de-Béarn, Sauveterre and the gaves: rivers, salt and rafting.',
  'coeur-de-bearn':        'Orthez, Navarrenx and the Béarn countryside.',
  'haut-bearn':            'Oloron-Sainte-Marie and the Aspe and Barétous valleys.',
  'lourdes':               'Grotto sanctuary, Lourdes spring, processions.',
  'pays-basque':           'Biarritz, Bayonne, Saint-Jean-de-Luz and the Basque hinterland.',
  'vallee-d-ossau':        'High Pyrenees: Pic du Midi d\'Ossau, lakes, mountain villages.',
};
const LEVEL: Record<string, string> = {
  'pyrenees-atlantiques': 'Département',
  'nouvelle-aquitaine':   'Region',
  'groningen-province':   'Province',
  'pays-basque':           'Territory',
  'bearn-des-gaves':       'Territory',
  'coeur-de-bearn':        'Territory',
  'haut-bearn':            'Territory',
  'vallee-d-ossau':        'Territory',
};

/* Starttaal van het gesprek. Labels in de eigen taal, geen vlaggen: Windows
   toont vlag-emoji als losse letters, en een taal is geen land. */
const LANGS = [
  ['fr', 'Français'], ['en', 'English'], ['nl', 'Nederlands'], ['de', 'Deutsch'],
  ['es', 'Español'], ['it', 'Italiano'], ['zh', '中文'], ['ja', '日本語'],
] as const;
const ALL_LANGS: string[] = LANGS.map(([c]) => c);
/* Elke agent krijgt de taalknoppen. Alleen een uitzondering hier zetten als een
   agent minder talen moet tonen, bv. 'munich': ['de', 'en']. Staat de override in
   ElevenLabs bij een agent (nog) uit, dan valt de pagina vanzelf terug op een
   sessie zonder override; zie start() hieronder. */
const LANGS_BY_SLUG: Record<string, string[]> = {};

const SOURCE = new Map((sources as { id: string; name: string }[]).map(x => [x.id, x.name]));
const and = (xs: string[]) => xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;

const all = (await getCollection('destinations')).map(e => e.data).filter(x => !!x.voiceAgentId);
for (const f of FEATURED) {
  if (!all.some(x => x.slug === f)) throw new Error(`/channels/voice: featured demo "${f}" has no voiceAgentId in destinations.json`);
}
const rank = (slug: string) => { const k = FEATURED.indexOf(slug); return k === -1 ? Infinity : k; };
const demos = all
  .map(x => ({
    slug: x.slug,
    name: x.name?.en ?? x.slug,
    agentId: x.voiceAgentId as string,
    level: LEVEL[x.slug] ?? 'City',
    desc: DESC[x.slug] ?? '',
    langs: LANGS_BY_SLUG[x.slug] ?? ALL_LANGS,
    logo: x.logo ?? null,
    href: `/destinations/${x.slug}`,
    country: x.countryName,
    provenance: x.provenance,
    sourceName: x.dataSource ? (SOURCE.get(x.dataSource) ?? null) : null,
  }))
  .sort((a, b) => rank(a.slug) - rank(b.slug) || a.name.localeCompare(b.name, 'en'));

/* Groepen per land: Frankrijk eerst (daar staan de uitgewerkte demo's), daarna
   alfabetisch. */
const first = demos[0];
const countries = [...new Set(demos.map(d => d.country))]
  .sort((a, b) => (a === first.country ? -1 : b === first.country ? 1 : a.localeCompare(b, 'en')));
const groups = countries.map(c => ({
  title: c,
  id: 'c-' + c.toLowerCase().normalize('NFD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
  items: demos.filter(d => d.country === c),
}));

/* De bronnenzin bij de ElevenLabs-demo's, afgeleid uit wat die demo's werkelijk gebruiken. */
const feeds = [...new Set(demos.filter(d => d.provenance === 'official' && d.sourceName).map(d => d.sourceName as string))];
const hasPublic = demos.some(d => d.provenance === 'preview');
const sourceSentence = and([
  ...(feeds.length ? [`official open-data feeds (${and(feeds)})`] : []),
  ...(hasPublic ? ['public sources'] : []),
]);
const names = demos.map(d => d.name);
const metaNames = names.length > 7 ? `${names.slice(0, 6).join(', ')} and more` : and(names);
/* De volledig Europese spraakketen. Alleen wat echt draait, met waar het draait —
   dezelfde regel als de keten op /platform. Gradium alleen als EU-endpoint
   (eu.api.gradium.ai) in de worker staat; zie de handleiding. Talen die Gradium
   niet heeft (Nederlands, Italiaans, Chinees, Japans, Noors, Catalaans …) lopen
   via Mistral Voxtral 3 op het EU-endpoint van Mistral. */
const EU_CHAIN = [
  { k: 'Speech to text',   what: 'Gradium, or Mistral Voxtral 3 for the languages Gradium lacks', who: 'Gradium · Mistral', where: 'EU endpoints' },
  { k: 'Language model',   what: 'Mistral Small 3.2',                          who: 'Scaleway',                 where: 'Paris, FR' },
  { k: 'Destination data', what: "Our search over the destination's own data", who: 'Our own servers, Hetzner', where: 'Germany' },
  { k: 'Text to speech',   what: 'Gradium, or Mistral Voxtral 3 for the languages Gradium lacks', who: 'Gradium · Mistral', where: 'EU endpoints' },
  { k: 'Real-time audio',  what: 'LiveKit, open source WebRTC',                who: 'Our own servers, Hetzner', where: 'Germany' },
];
const euMail = `mailto:${SALES_EMAIL}?subject=${encodeURIComponent('Demo: fully European voice')}`;

/* Voice on the EU chain: counts and the per-destination picker, all from the
   tenant export (src/data/eu-voice.json). Country-level tenants (fr-eu, nl-eu,
   at-eu) and a few tenants without a page on this site count in the totals but
   are not in the picker: the picker only offers what the visitor can open. */
const euStats = euVoiceStats();
const allDest = (await getCollection('destinations')).map(e => e.data);
const EU_DEFAULT = 'strasbourg';
const euPick = allDest
  .map(x => ({ slug: x.slug, name: x.name?.en ?? x.slug, country: x.countryName, v: euVoiceOf(x) }))
  .filter(x => x.v)
  .map(x => ({ slug: x.slug, name: x.name, country: x.country, tenant: x.v!.tenant, main: LANG_NAME[x.v!.main] ?? x.v!.main, n: x.v!.langs.length }))
  .sort((a, b) => a.country.localeCompare(b.country, 'en') || a.name.localeCompare(b.name, 'en'));
const euPickCountries = [...new Set(euPick.map(x => x.country))];
const euFirst = euPick.find(x => x.slug === EU_DEFAULT) ?? euPick[0];
if (!euFirst) throw new Error('/channels/voice: no EU destination with voice in eu-voice.json');
/* The floor: every EU destination speaks at least this many; the country table shows who speaks more (Barcelona adds Catalan). */
const langsPerTenant = String(euStats.perTenant[0]);
const gradiumLangs = euStats.languages.filter(l => l.provider === 'gradium');
const mistralLangs = euStats.languages.filter(l => l.provider === 'mistral');
const WAYS = [
  { k: 'Web chat', what: 'Type and read. The concierge on the destination page, in the widget on the tourist office site, or on its own URL.', on: 'Every destination' },
  { k: 'Voice', what: 'Speak and listen, nothing to type: a voice button on a page, or by phone.', on: `${euStats.tenants} EU destinations on the European chain` },
  { k: 'Web & voice', what: 'Both in one window: the wave icon in the chat starts a spoken conversation; the cards, map and links stay on screen.', on: `${euStats.tenants} EU destinations, the default` },
];
---
<Base title="Voice demos" angle="dmo"
      description={`Talk to a destination. A fully European voice assistant, plus live demos on ElevenLabs for ${metaNames}, right in your browser.`}>
  <section class="mx-auto max-w-6xl px-5 pt-14 pb-8">
    <ChannelsNav />
    <p class="mb-3 text-xs font-bold tracking-widest text-(--color-terra) uppercase">Voice · live demo</p>
    <h1 class="h-display">Talk to a destination's AI.</h1>
    <p class="lede mt-5">
      Every voice here is an AI concierge, never a person. Ask out loud and hear the answer, from the open tourism data published for that destination:
      events, opening hours, restaurants, trails. On every EU destination the whole conversation stays
      in Europe, in {langsPerTenant} languages; outside the EU an international stack covers the rest.
    </p>
    <dl class="mt-7 grid max-w-3xl grid-cols-3 gap-3">
      {[[String(euStats.tenants), 'EU destinations with voice'], [langsPerTenant, 'spoken languages per destination'], [String(euStats.countries.length), 'countries, entirely in Europe']].map(([n, l]) => (
        <div class="rounded-2xl border border-(--color-line) bg-white px-4 py-3">
          <dt class="font-serif text-3xl font-semibold leading-none text-(--color-slate2)">{n}</dt>
          <dd class="mt-1.5 text-xs text-(--color-ink-2)">{l}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-3 max-w-[60ch] text-sm text-(--color-ink-3)">
      A destination's name and logo show which place the assistant covers; they do not mean the tourist
      office is a customer.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#eu-voice" class="rounded-full bg-(--color-slate2) px-5 py-2.5 text-sm font-semibold text-white transition hover:brightness-110">
        Fully European ↓
      </a>
      <a href="#demos" class="rounded-full border border-(--color-line) bg-white px-5 py-2.5 text-sm font-semibold text-(--color-ink) transition hover:border-(--color-ink-3)">
        International demos ↓
      </a>
    </div>
    <ul class="mt-6 flex flex-wrap gap-2 text-xs font-semibold text-(--color-ink-2)">
      <li class="rounded-full border border-(--color-line) bg-white px-3 py-1">European or international voice stack</li>
      <li class="rounded-full border border-(--color-line) bg-white px-3 py-1">In the browser, no app</li>
      <li class="rounded-full border border-(--color-line) bg-white px-3 py-1">Microphone only after you tap</li>
    </ul>
  </section>

  <section class="border-t border-(--color-line-2) py-12">
    <div class="mx-auto max-w-6xl px-5">
      <p class="mb-3 text-xs font-bold tracking-widest text-(--color-slate2) uppercase">Three ways to deploy it</p>
      <h2 class="h-section">Chat, voice, or both in one window.</h2>
      <p class="mt-3 max-w-[66ch] text-(--color-ink-2)">
        Same assistant, same data, same answers. Pick per destination how visitors reach it; the social
        channels (WhatsApp, Instagram, Messenger) are a separate choice on the <a href="/channels" class="font-semibold text-(--color-pine) underline underline-offset-2">channels page</a>.
      </p>
      <ol class="mt-6 grid gap-4 sm:grid-cols-3">
        {WAYS.map((w, i) => (
          <li class={`rounded-2xl border bg-white p-5 ${i === 2 ? 'border-(--color-slate2)' : 'border-(--color-line)'}`}>
            <div class="flex items-center justify-between gap-2">
              <span class="font-serif text-xl font-semibold">{w.k}</span>
              {i === 2 && <span class="rounded-full bg-(--color-slate2) px-2.5 py-0.5 text-[11px] font-semibold text-white">Default in the EU</span>}
            </div>
            <p class="mt-2 text-sm text-(--color-ink-2)">{w.what}</p>
            <p class="mt-3 text-xs font-semibold text-(--color-ink-3)">Live on: <span class="text-(--color-ink)">{w.on}</span></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="eu-voice" class="scroll-mt-20 border-t border-(--color-line-2) py-14">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 lg:grid-cols-[1fr_1.35fr] lg:items-start">
      <div>
        <p class="mb-3 text-xs font-bold tracking-widest text-(--color-slate2) uppercase">Fully European · EU sovereignty</p>
        <h2 class="h-section">The whole conversation,<br />inside Europe.</h2>
        <p class="mt-4 text-(--color-ink-2)">
          Our European voice stack keeps every step of the conversation in the EU: European speech
          technology for listening and speaking, Mistral for the answers, and our own servers for the data
          and the audio. No US cloud anywhere in the chain.
        </p>
        <p class="mt-3 text-(--color-ink-2)">
          For tourist offices that want visitor conversations to stay under European rules, this is the
          stack to start from.
        </p>
        <p class="mt-3 text-sm text-(--color-ink-3)">
          Live on {euStats.tenants} destinations in {euStats.countries.length} countries, {langsPerTenant} languages each.
          Pick one below and talk to it here, or open its chat and tap the wave icon.
        </p>

        <div id="eu" class="mt-6 flex items-center gap-5 rounded-2xl border border-(--color-line) bg-white p-5">
          <button id="eu-orb" type="button" data-state="idle" aria-label="Start the European AI voice demo"
                  class="vc-orb vc-orb-eu grid h-24 w-24 shrink-0 place-items-center rounded-full text-white">
            <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="3" width="6" height="11" rx="3" />
              <path d="M5 11a7 7 0 0 0 14 0M12 18v3M8.5 21h7" />
            </svg>
          </button>
          <div class="min-w-0 flex-1 text-left">
            <label for="eu-pick" class="text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Live · talk to</label>
            <select id="eu-pick" class="mt-1 block w-full max-w-xs rounded-lg border border-(--color-line) bg-white px-2.5 py-1.5 text-sm font-semibold text-(--color-ink)">
              {euPickCountries.map(c => (
                <optgroup label={c}>
                  {euPick.filter(x => x.country === c).map(x => (
                    <option value={x.tenant} data-main={x.main} data-n={x.n} selected={x.slug === euFirst.slug}>{x.name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p id="eu-langs" class="mt-1 text-xs text-(--color-ink-3)">Starts in {euFirst.main} · {euFirst.n} languages, switch by speaking</p>
            <p id="eu-status" class="mt-1 min-h-6 text-base font-semibold" aria-live="polite">Tap to talk to the AI</p>
            <button id="eu-end" type="button" hidden
                    class="mt-2 rounded-full border border-(--color-slate2) px-4 py-1.5 text-sm font-semibold text-(--color-slate2) transition hover:bg-(--color-slate2-l)">
              End call
            </button>
          </div>
        </div>

        <a href={euMail} class="mt-5 inline-flex text-sm font-semibold text-(--color-slate2) underline underline-offset-2 hover:brightness-110">
          Talk to us about EU-first voice
        </a>
      </div>
      <ol class="grid gap-3 sm:grid-cols-2">
        {EU_CHAIN.map((c, i) => (
          <li class="rounded-2xl border border-(--color-line) bg-white p-5">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold tracking-wider text-(--color-ink-3) uppercase">{i + 1} · {c.k}</span>
              <span class="rounded-full bg-(--color-pine-l) px-2.5 py-0.5 text-[11px] font-semibold text-(--color-pine)">EU</span>
            </div>
            <p class="mt-2 font-semibold text-(--color-ink)">{c.what}</p>
            <p class="mt-1 text-sm text-(--color-ink-2)">{c.who} · {c.where}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mx-auto mt-12 grid max-w-6xl gap-8 px-5 lg:grid-cols-[1fr_1.35fr] lg:items-start">
      <div class="overflow-x-auto rounded-2xl border border-(--color-line) bg-white">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-(--color-line-2) text-left text-[11px] font-bold tracking-wider text-(--color-ink-3) uppercase">
              <th class="px-4 py-2.5">Country</th>
              <th class="px-2 py-2.5 text-right">Destinations</th>
              <th class="hidden px-2 py-2.5 sm:table-cell">Starts in</th>
              <th class="px-4 py-2.5 text-right">Languages</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-(--color-line-2)">
            {euStats.countries.map(c => (
              <tr>
                <td class="px-4 py-2.5 font-semibold">{c.name}</td>
                <td class="px-2 py-2.5 text-right tabular-nums">{c.count}</td>
                <td class="hidden px-2 py-2.5 whitespace-nowrap text-(--color-ink-2) sm:table-cell">{c.main.join(' or ')}</td>
                <td class="px-4 py-2.5 text-right tabular-nums">{c.langs}{c.note ? <span class="block text-[11px] font-normal text-(--color-ink-3)">{c.note}</span> : null}</td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr class="border-t border-(--color-line) bg-(--color-paper-2) font-semibold">
              <td class="px-4 py-2.5">Total</td>
              <td class="px-2 py-2.5 text-right tabular-nums">{euStats.tenants}</td>
              <td class="hidden px-2 py-2.5 text-xs font-normal whitespace-nowrap text-(--color-ink-3) sm:table-cell">Updated {UPDATED}</td>
              <td class="px-4 py-2.5 text-right text-xs font-normal text-(--color-ink-3) sm:hidden">Updated {UPDATED}</td>
              <td class="hidden px-4 py-2.5 sm:table-cell"></td>
            </tr>
          </tfoot>
        </table>
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Spoken languages · every EU destination</p>
        <p class="mt-2 text-sm text-(--color-ink-2)">
          Listening is {STT.who} for every language, with automatic detection: the visitor just talks.
          The voice that answers depends on the language.
        </p>
        {[['Gradium voices', gradiumLangs], ['Mistral Voxtral 3 voices', mistralLangs]].map(([title, ls]) => (
          <div class="mt-4">
            <p class="text-xs font-semibold text-(--color-ink-3)">{title as string}</p>
            <ul class="mt-1.5 flex flex-wrap gap-1.5">
              {(ls as typeof gradiumLangs).map(l => (
                <li class="rounded-full border border-(--color-line) bg-white px-3 py-1 text-sm" title={l.tenants === euStats.tenants ? 'All EU destinations' : `${l.tenants} destinations`}>
                  <span class="font-semibold">{l.name}</span> <span class="text-(--color-ink-3)">{l.native}</span>
                  {l.tenants < euStats.tenants && <span class="ml-1 text-[11px] text-(--color-ink-3)">· {l.tenants === 1 ? 'one destination' : `${l.tenants} destinations`}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p class="mt-4 text-xs text-(--color-ink-3)">
          Only these languages are spoken. Ask in another language and the answer is spoken in English,
          with a note that the chat itself understands more. The voice switches when the visitor does,
          also between Gradium and Mistral.
        </p>
      </div>
    </div>
  </section>

  <section id="demos" class="scroll-mt-20 border-t border-(--color-line-2) py-14">
    <div class="mx-auto max-w-6xl px-5">
    <div class="mb-8 max-w-[68ch]">
      <p class="mb-3 text-xs font-bold tracking-widest text-(--color-terra) uppercase">Outside the EU · international edition · ElevenLabs (US)</p>
      <h2 class="h-section">Beyond Europe, almost any language.</h2>
      <p class="mt-4 text-(--color-ink-2)">
        For destinations outside the EU, and for anyone who prefers it, the international edition runs on
        ElevenLabs, a US provider. It understands and answers in almost any language, switching when you do.
      </p>
