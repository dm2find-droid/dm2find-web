---
import Base from '../../layouts/Base.astro';
import CountryBody from '../../components/CountryBody.astro';
import { countryProps } from '../../lib/pageData';
import { t, countryName, DEFAULT_LOCALE } from '../../i18n/ui';

export async function getStaticPaths() {
  const rows = await countryProps();
  return rows.map(r => ({ params: { country: r.code }, props: r.props }));
}
const { dests, name, source } = Astro.props;
const loc = DEFAULT_LOCALE;
const _ = t(loc);
---
<Base title={countryName(loc, dests[0]?.country ?? '', name)} description={_('country.meta', { n: dests.length, country: countryName(loc, dests[0]?.country ?? '', name) })}>
  <CountryBody dests={dests} name={name} source={source} locale={DEFAULT_LOCALE} />
</Base>
