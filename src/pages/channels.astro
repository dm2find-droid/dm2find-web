---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Chat from '../components/Chat.astro';
import VoiceDemo from '../components/VoiceDemo.astro';

const all = (await getCollection('destinations')).map(e => e.data);
const chatDemo  = all.find(d => d.slug === 'bolzano') ?? all[0];
const voiceDemo = all.find(d => d.slug === 'nancy')   ?? all[0];

/** Authoritative channel walkthroughs. The list lives in src/data/channels.json
 *  so scripts/fetch-thumbs.mjs and this page can never disagree about which
 *  videos exist. Order is deliberate: the two Meta channels sit together, Voice
 *  last because it leads back to the live widget above.
 *  `note` renders under the card; `img` means a screenshot, not a clip. */
import raw from '../data/channels.json';
import tipsRaw from '../data/email-tips.json';

const here = (p?: string) => !!p && existsSync(`public${p}`);
const channels = (raw as any[])
  // never ship a card that would open an empty lightbox
  .filter(c => c.yt || here(c.img) || c.badge)
  .map(c => ({
    ...c,
    playable: !!(c.yt || here(c.img)),
    /* Poster frame, self-hosted by the prebuild step. Falls back to the
     * gradient card if the fetch didn't happen — never a broken image. */
    poster: c.yt && here(`/channels/yt-${c.yt}.jpg`) ? `/channels/yt-${c.yt}.jpg`
          : here(c.img) ? c.img
          : null,
  }));

/** Event tips by email — staande shorts, alleen in de talen die echt bestaan. */
const tips = (tipsRaw as any).videos.map((v: any) => ({
  ...v,
  poster: here(`/channels/yt-${v.id}.jpg`) ? `/channels/yt-${v.id}.jpg` : null,
}));
---
<Base title="Channels" angle="dmo"
      description="Webchat is the product. Messaging channels and voice are reach, added when your visitors are actually there.">
  <section class="mx-auto max-w-6xl px-5 py-14">
    <p class="mb-3 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Channels</p>
    <h1 class="h-display">Webchat is the product.<br />The rest is reach.</h1>
    <p class="lede mt-5">
      Start with the thing you can try right now. Add a messaging channel later, if and when your
      visitors are actually there.
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-(--color-pine-l) px-3 py-1 text-xs font-semibold text-(--color-pine)">
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span> Live demo
        </span>
        <h2 class="h-section mt-3">Webchat</h2>
        <p class="mt-2 text-sm text-(--color-ink-2)">
          Embedded on the destination's own site, or standalone. Images, opening hours, distances and
          booking links inline.
        </p>
        <div class="mt-5"><Chat name={chatDemo.name.en} chatUrl={chatDemo.chatUrl} /></div>
      </div>
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-(--color-pine-l) px-3 py-1 text-xs font-semibold text-(--color-pine)">
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span> Live demo
        </span>
        <h2 class="h-section mt-3">Voice widget</h2>
        <p class="mt-2 text-sm text-(--color-ink-2)">
          Tap and talk, in the browser. The only voice option you can try without picking up a phone.
        </p>
        <div class="mt-5">
          <VoiceDemo agentId="agent_0401knvgg4a9e3qrtmjjtazq91x6" place={voiceDemo.name.en} />
        </div>
      </div>
    </div>
  </section>


  <section id="email-tips" class="mx-auto max-w-6xl px-5 pb-14">
    <div class="grid items-start gap-8 rounded-2xl border border-(--color-line) bg-white p-7 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-(--color-amber-l) px-3 py-1 text-xs font-semibold text-(--color-amber)">
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span> Optional module
        </span>
        <h2 class="h-section mt-3">Event tips by email</h2>
        <p class="mt-3 text-(--color-ink-2)">
          In the chat menu a visitor taps <b>Event tips by email</b>, picks the kinds of events they care
          about and leaves an address. Nothing is sent until they confirm it through a verification email.
          After that, a digest of matching events arrives every two weeks.
        </p>
        <ul class="mt-4 space-y-2 text-sm text-(--color-ink-2)">
          <li><b class="text-(--color-ink)">Double opt-in.</b> An address someone typed is not consent; a confirmed one is.</li>
          <li><b class="text-(--color-ink)">Only what they asked for.</b> The event types they picked, not the whole calendar.</li>
          <li><b class="text-(--color-ink)">Sent from Europe.</b> The mail goes out via Scaleway in Paris.</li>
          <li><b class="text-(--color-ink)">An audience the destination builds itself</b> — from people who were already asking it questions.</li>
        </ul>
        <p class="mt-4 text-xs text-(--color-ink-3)">Walkthroughs so far in French and Dutch.</p>
      </div>
      <div class="flex justify-center gap-4 lg:justify-end">
        {tips.map((v: any) => (
          <div class="w-[42%] max-w-[180px]">
            <button data-lb="video" data-yt={v.id} data-ratio="vertical" data-gallery="email-tips"
                    data-cap={`Event tips by email — ${v.label}`} lang={v.lang}
                    class="group relative block aspect-[9/16] w-full overflow-hidden rounded-xl bg-gradient-to-br from-[#4E5C56] to-[#232B28]">
              {v.poster && (
                <img src={v.poster} alt="" loading="lazy" decoding="async"
                     class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
              )}
              <span class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-black/20"></span>
              <span class="absolute inset-0 grid place-items-center">
                <span class="grid h-11 w-11 place-items-center rounded-full bg-white/95 text-(--color-ink) shadow-lg transition group-hover:scale-110">▶</span>
              </span>
              <span class="absolute bottom-3 left-3 text-sm font-semibold text-white drop-shadow">{v.label}</span>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-(--color-line-2) bg-(--color-paper-2) py-12">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="h-section">Optional channels, on video</h2>
      <p class="mt-2 max-w-[64ch] text-sm text-(--color-ink-2)">
        No demos here on purpose — these run inside apps we can't embed. Each video shows a real
        conversation end to end.
      </p>
      <div class="mt-6 grid gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {channels.map(c => (
          <div>
            {c.playable ? (
              <button data-lb={c.yt ? 'video' : 'image'} data-yt={c.yt} data-src={c.img}
                      data-cap={`${c.n} — DM2find concierge`} data-gallery="channels"
                      class="group relative block aspect-video w-full overflow-hidden rounded-xl bg-gradient-to-br from-[#4E5C56] to-[#232B28]">
                {c.poster && (
                  /* object-cover crops hqdefault's 4:3 letterboxing back to 16:9
                     and is a no-op on a true 1280x720 maxresdefault. */
                  <img src={c.poster} alt="" loading="lazy" decoding="async" width="1280" height="720"
                       class="absolute inset-0 h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" />
                )}
                <span class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-black/20"></span>
                <span class="absolute inset-0 grid place-items-center">
                  <span class="grid h-12 w-12 place-items-center rounded-full bg-white/95 text-lg text-(--color-ink) shadow-lg transition group-hover:scale-110">
                    {c.yt ? '▶' : '⤢'}
                  </span>
                </span>
                <span class="absolute bottom-3 left-3 text-sm font-semibold text-white drop-shadow">{c.n}</span>
              </button>
            ) : (
              <div class="relative grid aspect-video w-full place-items-center rounded-xl border border-dashed border-(--color-line) bg-white/60">
                <span class="text-sm font-semibold text-(--color-ink-2)">{c.n}</span>
                <span class="absolute bottom-3 left-3 text-[11px] text-(--color-ink-3)">Walkthrough coming</span>
              </div>
            )}
            {c.badge && (
              <span class="mt-2 inline-block rounded-full bg-(--color-pine-l) px-2.5 py-0.5 text-[11px] font-semibold text-(--color-pine)">
                {c.badge}
              </span>
            )}
            {c.note && <p class="mt-2 text-[11px] leading-snug text-(--color-ink-3)">{c.note}</p>}
          </div>
        ))}
      </div>
      {/* Commented out at your request — a greyed-out channel raises a question
          you don't want asked in a sales call, and naming them does the same:
          <p …>Not yet available: KakaoTalk and Zalo. …</p> */}
    </div>
  </section>
</Base>
