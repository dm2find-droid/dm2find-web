---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Chat from '../components/Chat.astro';

const all = (await getCollection('destinations')).map(e => e.data);
const demo = all.find(d => d.slug === 'bolzano') ?? all[0];

/** Real walkthroughs recovered from the old site. Where we have no clip yet the
 *  channel is listed without one rather than shown with a placeholder. */
import channelVideos from '../data/channel-videos.json';
const order = ['WhatsApp','Messenger','Instagram','Telegram','WeChat','LINE','Voice'];
const videos = order
  .filter(n => (channelVideos as Record<string, any>)[n])
  .map(n => ({ n, yt: (channelVideos as Record<string, any>)[n].id,
               cap: (channelVideos as Record<string, any>)[n].label }));
const noVideoYet = order.filter(n => !(channelVideos as Record<string, any>)[n]);
---
<Base title="Channels" angle="dmo"
      description="Webchat is the product. Messaging channels and voice are reach, added when your visitors are actually there.">
  <section class="mx-auto max-w-6xl px-5 py-14">
    <p class="mb-3 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">Channels</p>
    <h1 class="h-display">Webchat is the product.<br />The rest is reach.</h1>
    <p class="lede mt-5">
      Start with the thing you can try right now. Add a messaging channel later, if and when your
      visitors are actually there.
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-(--color-pine-l) px-3 py-1 text-xs font-semibold text-(--color-pine)">
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span> Live demo
        </span>
        <h2 class="h-section mt-3">Webchat</h2>
        <p class="mt-2 text-sm text-(--color-ink-2)">
          Embedded on the destination's own site, or standalone. Images, opening hours, distances and
          booking links inline.
        </p>
        <div class="mt-5"><Chat name={demo.name.en} chatUrl={demo.chatUrl} /></div>
      </div>
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-(--color-pine-l) px-3 py-1 text-xs font-semibold text-(--color-pine)">
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span> Live demo
        </span>
        <h2 class="h-section mt-3">Voice widget</h2>
        <p class="mt-2 text-sm text-(--color-ink-2)">
          Tap and talk, in the browser. The only voice option you can try without picking up a phone.
        </p>
        <div class="mt-5 rounded-2xl border border-(--color-line) bg-white p-10 text-center">
          <div class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-(--color-terra) text-3xl text-white">🎙</div>
          <p class="mt-4 text-sm text-(--color-ink-2)">Tap to speak with the {demo.name.en} concierge</p>
        </div>
        <p class="mt-3 text-xs text-(--color-ink-3)">
          Voice by phone and WhatsApp Call are shown on video below — they need a real number to try.
        </p>
      </div>
    </div>
  </section>

  <section class="border-y border-(--color-line-2) bg-(--color-paper-2) py-12">
    <div class="mx-auto max-w-6xl px-5">
      <h2 class="h-section">Optional channels, on video</h2>
      <p class="mt-2 max-w-[64ch] text-sm text-(--color-ink-2)">
        No demos here on purpose — these run inside apps we can't embed. Each video shows a real
        conversation end to end.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {videos.map(v => (
          <button data-lb="video" data-yt={v.yt} data-cap={v.cap} data-gallery="channels"
                  class="group relative aspect-video overflow-hidden rounded-xl bg-gradient-to-br from-[#4E5C56] to-[#232B28]">
            <span class="absolute inset-0 grid place-items-center">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-white/95 pl-1 text-lg text-(--color-ink) transition group-hover:scale-110">▶</span>
            </span>
            <span class="absolute bottom-3 left-3 text-sm font-semibold text-white">{v.n}</span>
            
          </button>
        ))}
      </div>
      {noVideoYet.length > 0 && (
        <p class="mt-5 text-sm text-(--color-ink-2)">
          Also available, walkthrough video coming: {noVideoYet.join(' · ')}.
        </p>
      )}
      <p class="mt-6 border-l-4 border-(--color-line) pl-4 text-sm text-(--color-ink-3)">
        Not yet available: KakaoTalk and Zalo. They are deliberately absent rather than listed as
        “coming soon” — a greyed-out channel raises a question you don't want asked in a sales call.
      </p>
    </div>
  </section>
</Base>
