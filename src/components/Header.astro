---
import { BOOKING_URL } from '../data/site';
import LangSwitch from './LangSwitch.astro';
import { t, localeHref, DEFAULT_LOCALE, type Locale } from '../i18n/ui';

interface Props { locale?: Locale; basePath?: string; showLang?: boolean }
const { locale = DEFAULT_LOCALE, basePath = '/', showLang = false } = Astro.props;
const _ = t(locale);

/* `localised: true` betekent dat de pagina in elke taal bestaat en dus een
   taalprefix krijgt. De marketingpagina's bestaan alleen in het Engels; daar
   linken we onvertaald naartoe in plaats van een vertaling te suggereren. */
const nav = [
  { href: '/travel',       label: _('nav.travel'),       localised: false },
  { href: '/destinations', label: _('nav.destinations'), localised: true  },
  { href: '/business',     label: _('nav.business'),     localised: false },
  { href: '/dmo',          label: _('nav.dmo'),          localised: false },
  { href: '/platform',     label: _('nav.platform'),     localised: false },
  { href: '/channels',     label: _('nav.channels'),     localised: false },
].map(n => ({ ...n, url: n.localised ? localeHref(locale, n.href) : n.href }));

const path = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-(--color-line) bg-(--color-paper)/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-1 px-5">
    <a href={localeHref(locale, '/')} class="mr-5 font-serif text-xl font-semibold tracking-tight whitespace-nowrap">
      DM2find<span class="text-(--color-terra)">.ai</span>
    </a>
    <nav id="nav" class="hidden flex-1 gap-0.5 md:flex">
      {nav.map(n => (
        <a href={n.url}
           class={`rounded-lg px-3 py-2 text-sm whitespace-nowrap ${
             path.startsWith(n.url) ? 'bg-(--color-paper-3) font-semibold' : 'text-(--color-ink-2) hover:bg-(--color-paper-2)'}`}>
          {n.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto hidden items-center gap-2 md:flex">
      {/* Alleen tonen waar de vertaling ook bestaat: een schakelaar naar
          een 404 is erger dan geen schakelaar. */}
      {showLang && <LangSwitch locale={locale} basePath={basePath} label={_('nav.language')} />}
      <a href={BOOKING_URL} target="_blank" rel="noopener"
         class="rounded-full bg-(--color-pine) px-4 py-2 text-sm font-semibold text-white transition hover:brightness-110">
        {_('nav.book')}
      </a>
    </div>
    <button id="burger" aria-label={_('nav.menu')} class="ml-auto rounded-lg border border-(--color-line) px-3 py-2 md:hidden">☰</button>
  </div>
  <nav id="mnav" class="hidden flex-col gap-1 border-t border-(--color-line) px-5 pb-4 md:hidden">
    {nav.map(n => <a href={n.url} class="py-3 text-base">{n.label}</a>)}
    {/* The desktop CTA is md:inline-block, so without this the booking link was
        invisible on a phone — where most of your traveller traffic will be. */}
    <a href={BOOKING_URL} target="_blank" rel="noopener"
       class="mt-2 rounded-full bg-(--color-pine) px-4 py-3 text-center text-base font-semibold text-white">
      {_('nav.book')}
    </a>
    {showLang && <div class="mt-3"><LangSwitch locale={locale} basePath={basePath} label={_('nav.language')} /></div>}
  </nav>
</header>
<script>
  document.getElementById('burger')?.addEventListener('click', () => {
    const m = document.getElementById('mnav');
    m?.classList.toggle('hidden'); m?.classList.toggle('flex');
  });
</script>
