---
import ProvenanceBadge from './ProvenanceBadge.astro';
import { localeHref, countryName, DEFAULT_LOCALE, type Locale } from '../i18n/ui';
/** `href` overschrijft de standaardlink. De landelijke concierges hebben geen
 *  bestemmingspagina; die wijzen naar hun landpagina. */
const { d, locale = DEFAULT_LOCALE, href } = Astro.props as { d: any; locale?: Locale; href?: string };

/**
 * Card artwork, in order of what we actually have:
 *   1. a real photograph of the place            -> show it
 *   2. the DMO's own logo and brand colour       -> show that, on their colour
 *   3. neither                                   -> a tinted plate, varied per
 *      destination so a grid of them reads as a catalogue rather than a wall
 *      of identical slabs
 *
 * Deliberately no generic stock photography in slot 3. A stock beach under a
 * landlocked town is the kind of detail a DMO notices immediately, and the
 * whole pitch on /dmo is that we do not fake data.
 */

/* eight earthy duotones, picked so any of them sits comfortably on paper */
const PLATES = [
  ['#C9A227', '#7A5C1E'], ['#4E7A63', '#22453A'], ['#B4643C', '#6E3320'],
  ['#5B7C99', '#2C4459'], ['#8A7CA8', '#4A3F63'], ['#A8894B', '#5E4A26'],
  ['#6E8B5A', '#37502C'], ['#9C5A6B', '#5A2E3A'],
];
/* stable hash so a destination keeps the same plate between builds */
const hash = [...d.slug].reduce((a: number, c: string) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const plate = PLATES[hash % PLATES.length];

const shade = (hex: string, amount = 0.45) => {
  const n = parseInt(hex.replace('#', '').padEnd(6, '0').slice(0, 6), 16);
  const mix = (c: number) => Math.round(c * (1 - amount));
  return '#' + [(n >> 16) & 255, (n >> 8) & 255, n & 255]
    .map(c => mix(c).toString(16).padStart(2, '0')).join('');
};

/* Brand colours come in at full saturation and a grid of 300 of them is loud
   against paper. Knocking the top stop back a little keeps each destination
   recognisable while letting the page stay calm. */
const from = d.brandColor ? shade(d.brandColor, 0.14) : plate[0];
const to   = d.brandColor ? shade(d.brandColor, 0.58) : plate[1];
---
<a href={href ?? localeHref(locale, `/destinations/${d.slug}`)}
   class="group flex flex-col overflow-hidden rounded-xl border border-(--color-line) bg-white transition hover:-translate-y-0.5 hover:border-(--color-terra)">
  <div class="relative aspect-video overflow-hidden"
       style={`background-image:linear-gradient(135deg, ${from}, ${to})`}>
    {d.image ? (
      <img src={d.image.src} alt={d.name.en} loading="lazy" decoding="async"
           class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" />
    ) : d.logo ? (
      <span class="absolute inset-0 grid place-items-center p-5">
        <span class="grid max-h-[76%] w-[62%] place-items-center rounded-xl bg-white/92 p-3 shadow-sm">
          <img src={d.logo} alt="" loading="lazy" decoding="async"
               class="max-h-16 w-full object-contain" />
        </span>
      </span>
    ) : (
      /* no artwork at all: a quiet pin watermark, so the plate reads as a
         place rather than as a missing image */
      <span class="absolute inset-0 grid place-items-center">
        <svg width="46" height="46" viewBox="0 0 24 24" fill="none" aria-hidden="true"
             class="opacity-30 transition group-hover:opacity-45">
          <path d="M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7z"
                stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/>
          <circle cx="12" cy="9" r="2.4" fill="#fff"/>
        </svg>
      </span>
    )}
  </div>
  <div class="p-4">
    <h3 class="font-serif text-lg font-semibold">{d.name.en}</h3>
    <p class="mt-0.5 text-sm text-(--color-ink-3)">{d.region ?? countryName(locale, d.country, d.countryName)}</p>
    <p class="mt-2 text-xs text-(--color-ink-3)">{d.channels.join(' · ')}</p>
  </div>
  <div class="mt-auto border-t border-(--color-line-2) bg-(--color-paper-2) px-4 py-2.5">
    <ProvenanceBadge provenance={d.provenance} locale={locale} />
  </div>
</a>
