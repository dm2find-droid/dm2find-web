---
/**
 * The flag of Europe as inline SVG: twelve five-pointed stars on a circle,
 * on the official blue. Inline so it never fails to load, and so a card grid
 * of 300 destinations does not fire 300 image requests. Decorative: the text
 * next to it carries the meaning, so it is hidden from screen readers.
 */
interface Props { size?: number; class?: string }
const { size = 20, class: cls = '' } = Astro.props;
/* a five-pointed star, radius 1, centred on 0,0 */
const star = (() => {
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const r = i % 2 === 0 ? 1 : 0.382;
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    pts.push(`${(Math.cos(a) * r).toFixed(3)},${(Math.sin(a) * r).toFixed(3)}`);
  }
  return pts.join(' ');
})();
const stars = Array.from({ length: 12 }, (_, i) => {
  const a = (i * Math.PI) / 6;
  return { x: 18 + Math.cos(a) * 10, y: 12 + Math.sin(a) * 10 };
});
---
<svg viewBox="0 0 36 24" width={size * 1.5} height={size} class={cls} aria-hidden="true" focusable="false">
  <rect width="36" height="24" rx="2" fill="#003399" />
  {stars.map(s => (
    <polygon points={star} fill="#FFCC00" transform={`translate(${s.x.toFixed(2)} ${s.y.toFixed(2)}) scale(1.55)`} />
  ))}
</svg>
