---
/**
 * Dependency-free lightbox for images and YouTube video.
 * Deliberately not Fancybox or any third-party bundle:
 *  - no external JS, nothing to keep updated, no licence question
 *  - no cookies or third-party requests until the visitor clicks
 *  - YouTube loads via youtube-nocookie.com, and only on demand
 * That keeps the EU-privacy story on /platform/sovereignty literally true.
 *
 * Usage:
 *   <button data-lb="video" data-yt="VIDEO_ID" data-cap="WhatsApp walkthrough">…</button>
 *   <button data-lb="image" data-src="/img/x.jpg" data-cap="Bordeaux" data-gallery="bordeaux">…</button>
 */
---
<div id="lb" class="fixed inset-0 z-[100] hidden items-center justify-center bg-[rgba(24,20,16,.92)] p-6"
     role="dialog" aria-modal="true" aria-label="Media viewer">
  <button id="lb-x" aria-label="Close" class="absolute top-4 right-5 text-3xl leading-none text-white">&times;</button>
  <button id="lb-prev" aria-label="Previous" class="absolute left-2 top-1/2 -translate-y-1/2 px-4 py-2 text-4xl text-white/80 hover:text-white">&lsaquo;</button>
  <button id="lb-next" aria-label="Next" class="absolute right-2 top-1/2 -translate-y-1/2 px-4 py-2 text-4xl text-white/80 hover:text-white">&rsaquo;</button>
  <figure class="w-full max-w-4xl">
    <div id="lb-slot" class="overflow-hidden rounded-xl bg-black"></div>
    <figcaption id="lb-cap" class="mt-3 text-sm text-[#EDE4D8]"></figcaption>
  </figure>
</div>

<script>
  const box  = document.getElementById('lb')!;
  const slot = document.getElementById('lb-slot')!;
  const cap  = document.getElementById('lb-cap')!;
  const prev = document.getElementById('lb-prev')!;
  const next = document.getElementById('lb-next')!;
  let group: HTMLElement[] = [];
  let idx = 0;

  const render = (el: HTMLElement) => {
    const kind = el.dataset.lb;
    if (kind === 'video') {
      const id = el.dataset.yt!;
      slot.innerHTML =
        `<iframe class="aspect-video w-full border-0" allow="autoplay; encrypted-media; fullscreen"
                 allowfullscreen loading="lazy"
                 src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0"></iframe>`;
    } else {
      slot.innerHTML =
        `<img src="${el.dataset.src}" alt="${el.dataset.cap ?? ''}" class="max-h-[78vh] w-full object-contain">`;
    }
    cap.textContent = el.dataset.cap ?? '';
    const many = group.length > 1;
    prev.style.display = many ? '' : 'none';
    next.style.display = many ? '' : 'none';
  };

  const open = (el: HTMLElement) => {
    const g = el.dataset.gallery;
    group = g ? Array.from(document.querySelectorAll<HTMLElement>(`[data-gallery="${g}"]`)) : [el];
    idx = Math.max(0, group.indexOf(el));
    render(el);
    box.classList.remove('hidden'); box.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    box.classList.add('hidden'); box.classList.remove('flex');
    slot.innerHTML = '';                      // stops video playback
    document.body.style.overflow = '';
  };
  const step = (n: number) => { idx = (idx + n + group.length) % group.length; render(group[idx]); };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement)?.closest<HTMLElement>('[data-lb]');
    if (t) { e.preventDefault(); open(t); }
  });
  document.getElementById('lb-x')!.addEventListener('click', close);
  prev.addEventListener('click', () => step(-1));
  next.addEventListener('click', () => step(1));
  box.addEventListener('click', (e) => { if (e.target === box) close(); });
  document.addEventListener('keydown', (e) => {
    if (box.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft')  step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  // swipe on touch
  let x0 = 0;
  box.addEventListener('touchstart', (e) => { x0 = e.changedTouches[0].clientX; }, { passive: true });
  box.addEventListener('touchend',   (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 60 && group.length > 1) step(dx < 0 ? 1 : -1);
  }, { passive: true });
</script>
