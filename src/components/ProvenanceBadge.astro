---
interface Props { provenance: 'official' | 'preview'; sourceName?: string }
const { provenance, sourceName } = Astro.props;
const official = provenance === 'official';
---
<span class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ${
  official ? 'bg-(--color-pine-l) text-(--color-pine)' : 'bg-(--color-amber-l) text-(--color-amber)'}`}>
  <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
  {official ? (sourceName ? `Official feed · ${sourceName}` : 'Official feed') : 'Public sources'}
</span>
