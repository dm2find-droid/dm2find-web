---
/**
 * Deliberately NOT the EU flag emblem (circle of twelve stars).
 * That emblem is governed by usage guidelines and implies endorsement by an
 * EU institution — which we do not have. These are neutral typographic badges
 * that make the same factual claim without borrowing anyone's authority.
 */
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const badges = [
  { t: 'Developed in the EU', s: 'Built by an EU company', icon: 'code' },
  { t: 'Hosted in the EU',    s: 'Our own European servers', icon: 'server' },
];
---
<div class={`flex flex-wrap gap-3 ${compact ? '' : 'mt-6'}`}>
  {badges.map(b => (
    <div class="flex items-center gap-3 rounded-xl border border-(--color-line) bg-white px-4 py-3">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"
           class="shrink-0 text-(--color-pine)">
        {b.icon === 'server' ? (
          <>
            <rect x="3" y="4"  width="18" height="6" rx="2" stroke="currentColor" stroke-width="1.6"/>
            <rect x="3" y="14" width="18" height="6" rx="2" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="7" cy="7"  r="1.1" fill="currentColor"/>
            <circle cx="7" cy="17" r="1.1" fill="currentColor"/>
          </>
        ) : (
          <>
            <path d="M9 7 4.5 12 9 17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="m15 7 4.5 5-4.5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </>
        )}
      </svg>
      <div class="leading-tight">
        <div class="text-sm font-semibold">{b.t}</div>
        <div class="text-xs text-(--color-ink-3)">{b.s}</div>
      </div>
    </div>
  ))}
</div>
