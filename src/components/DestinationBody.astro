---
import Chat from './Chat.astro';
import AskExamples from './AskExamples.astro';
import VoiceDemo from './VoiceDemo.astro';
import ProvenanceBadge from './ProvenanceBadge.astro';
import DestinationCard from './DestinationCard.astro';
import EuSovereignBadge from './EuSovereignBadge.astro';
import EuFlag from './EuFlag.astro';
import { linkAttrs } from '../lib/link';
import { channelsOf, channelLabel } from '../lib/channels';
import { euVoiceOf } from '../lib/euVoice';
import { t, localeHref, countryName, DEFAULT_LOCALE, type Locale } from '../i18n/ui';

interface Props { d: any; source: any; siblings: any[]; curatedCount: number; locale?: Locale }
const { d, source, siblings, curatedCount, locale = DEFAULT_LOCALE } = Astro.props;
const _ = t(locale);
const official = d.provenance === 'official';

/* Attribution renders ONLY where the data genuinely came from that source.
   Rendering it for a preview destination would be a false attribution claim. */
const attribution = official && source?.attributionRequired ? source.attribution : null;
const place = d.name.en;
const country = countryName(locale, d.country, d.countryName);

/* EU-first. A destination with a European tenant opens THAT chat: the page
   must deliver what the badge promises. The international tenant stays
   reachable one click away, because it has features the EU chain does not
   (photo recognition runs on a non-EU model). */
const eu = !!d.euTenantId;
const chatUrl = eu ? `https://chat.dm2find.ai/${d.euTenantId}` : d.chatUrl;
/* Voice on the EU chain only when the tenant export says so (src/data/eu-voice.json):
   the row then names the engines and how many languages this destination speaks. */
const euVoice = eu ? euVoiceOf(d) : null;
const chain = [
  { k: _('eu.chain.data'),    who: official ? `${source?.name} · ${country}` : `${_('dest.source.public')} · ${country}` },
  { k: _('eu.chain.model'),   who: _('eu.chain.model.who') },
  { k: _('eu.chain.hosting'), who: _('eu.chain.hosting.who') },
  ...(euVoice ? [{ k: _('eu.chain.voice'), who: `${_('eu.chain.voice.who')} · ${_('eu.voice.langs', { n: String(euVoice.langs.length) })}`, href: '/channels/voice#eu-voice' }] : []),
  /* OpenFreeMap runs on Hetzner machines in the EU, but it is not our contract: say "Europe", not "our servers". */
  { k: _('eu.chain.map'),     who: _('eu.chain.map.who') },
];
---
<section class="mx-auto max-w-6xl px-5 pt-8 pb-12">
  <nav class="text-sm text-(--color-ink-3)">
    <a href={localeHref(locale, '/')}>{_('crumb.home')}</a> →
    <a href={localeHref(locale, '/destinations')}>{_('crumb.destinations')}</a> →
    <a href={localeHref(locale, `/countries/${d.country.toLowerCase()}`)}>{country}</a> → {place}
  </nav>

  <div class="mt-5 flex flex-wrap items-center gap-4">
    {d.logo && (
      <img src={d.logo} alt={_('dest.office', { place })} width="56" height="56" loading="lazy"
           class="h-14 w-14 rounded-xl border border-(--color-line) bg-white object-contain p-1.5" />
    )}
    <h1 class="h-display">{_('dest.title', { place })}</h1>
    <ProvenanceBadge provenance={d.provenance} sourceName={official ? source?.name : undefined} locale={locale} />
    {eu && <EuSovereignBadge locale={locale} href="#eu" />}
  </div>
  <p class="lede mt-4">
    {official
      ? _('dest.lede.official', { country, source: source?.name ?? '' })
      : _('dest.lede.preview', { place, country })}
  </p>

  {eu && (
    <div id="eu" class="mt-6 flex scroll-mt-24 flex-col gap-5 rounded-2xl border border-[#003399]/15 bg-[#EEF2FB] p-5 sm:flex-row sm:items-center sm:gap-6">
      <EuFlag size={44} class="shrink-0 self-start rounded-md shadow-sm sm:self-center" />
      <div class="min-w-0 flex-1">
        <p class="text-xs font-bold tracking-widest text-[#1D3A8A] uppercase">{_('eu.hero.kicker')}</p>
        <p class="mt-1 font-serif text-xl font-semibold leading-tight text-(--color-ink)">{_('eu.hero.title')}</p>
        <p class="mt-1.5 max-w-[66ch] text-sm text-(--color-ink-2)">{_('eu.hero.body')}</p>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-2">
        <a href="/platform#sovereignty" class="rounded-full border border-[#1D3A8A]/30 bg-white px-4 py-2 text-sm font-semibold text-[#1D3A8A] transition hover:border-[#1D3A8A]">
          {_('eu.hero.link')}
        </a>
        <a href="/channels/voice#eu-voice" class="px-4 text-sm font-semibold text-[#1D3A8A] underline-offset-2 hover:underline">
          {_('eu.hero.voice')}
        </a>
      </div>
    </div>
  )}

  <div class="mt-8 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
    <div>
      <AskExamples d={d} chatUrl={chatUrl} locale={locale} />
      <Chat name={place} chatUrl={chatUrl} eu={eu}
            barLabel={eu ? _('eu.webchat', { place }) : _('dest.webchat', { place })}
            fullLabel={_('dest.fullscreen')}
            fullTitle={_('dest.fullscreen.title', { place })} />
      <p class="mt-2 text-xs text-(--color-ink-3)">
        {_('dest.bigger')}
        <a href={chatUrl} target="_blank" rel="noopener"
           class="font-semibold text-(--color-pine) underline">{_('dest.bigger.link', { place })}</a>
      </p>
      {eu && (
        <p class="mt-1 text-xs text-(--color-ink-3)">
          {_('eu.intl')}
          <a href={d.chatUrl} target="_blank" rel="noopener" class="underline hover:text-(--color-ink)">{_('eu.intl.link')}</a>
        </p>
      )}
      {d.voiceAgentId && (
        <div class="mt-6">
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-semibold">{_('dest.talk')}</h2>
            <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${
              eu ? 'bg-(--color-amber-l) text-(--color-amber)' : 'bg-(--color-pine-l) text-(--color-pine)'}`}>
              <span class="h-1.5 w-1.5 rounded-full bg-current"></span> {eu ? _('eu.voice.intl') : _('dest.voicedemo')}
            </span>
          </div>
          <div class="mt-3"><VoiceDemo agentId={d.voiceAgentId} place={place} /></div>
        </div>
      )}
      {d.videos.length > 0 && (
        <div class="mt-6">
          <h2 class="text-sm font-semibold">{_('dest.video')}</h2>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {d.videos.map((v: any) => (
              <button data-lb="video" data-yt={v.id} data-cap={v.label} data-gallery={`d-${d.slug}`}
                      class="group relative aspect-video overflow-hidden rounded-xl bg-(--color-ink)">
                <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy"
                     class="absolute inset-0 h-full w-full object-cover opacity-80 transition group-hover:opacity-100" />
                <span class="absolute inset-0 grid place-items-center">
                  <span class="grid h-11 w-11 place-items-center rounded-full bg-white/95 pl-1 text-(--color-ink)">▶</span>
                </span>
                <span class="absolute bottom-2 left-3 text-xs font-semibold text-white drop-shadow">{v.label}</span>
              </button>
            ))}
          </div>
        </div>
      )}
      {!official && (
        <div class="mt-4 rounded-xl border border-(--color-amber) bg-(--color-amber-l) px-4 py-3.5 text-sm text-(--color-ink-2)">
          <b>{_('dest.preview.title')}</b> {_('dest.preview.body', { place })}
          <a href="/dmo" class="font-semibold text-(--color-amber)"> {_('dest.preview.cta', { place })}</a>
        </div>
      )}
    </div>

    <aside class="space-y-4">
      {eu && (
        <div class="rounded-xl border border-[#003399]/15 bg-white p-5">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-sm font-semibold">{_('eu.chain.title')}</h2>
            <EuFlag size={14} class="rounded-[2px]" />
          </div>
          <ol class="mt-3 divide-y divide-(--color-line-2)">
            {chain.map(c => (
              <li class="flex items-start gap-3 py-2 text-sm">
                <span class="w-24 shrink-0 text-xs font-bold tracking-wider text-(--color-ink-3) uppercase">{c.k}</span>
                {c.href
                  ? <a href={c.href} class="min-w-0 text-(--color-ink-2) underline decoration-[#003399]/30 underline-offset-2 hover:text-[#1D3A8A]">{c.who}</a>
                  : <span class="min-w-0 text-(--color-ink-2)">{c.who}</span>}
                <span class="ml-auto shrink-0 rounded-full bg-[#EEF2FB] px-2 py-0.5 text-[11px] font-semibold text-[#1D3A8A]">EU</span>
              </li>
            ))}
          </ol>
        </div>
      )}
      <div class="rounded-xl border border-(--color-line) bg-white p-5">
        <h2 class="text-sm font-semibold">{_('dest.source.title')}</h2>
        <p class="mt-2 text-sm text-(--color-ink-2)">
          {official ? source?.name : _('dest.source.public')}
        </p>
        <p class="mt-1 text-xs text-(--color-ink-3)">
          {official ? _('dest.source.sync') : _('dest.source.compiled')}
        </p>
        {attribution && <p class="mt-3 text-xs italic text-(--color-ink-3)">{attribution}</p>}
        {d.website && (
          <a href={d.website} {...linkAttrs(d.website)}
             class="mt-3 inline-block text-sm font-semibold text-(--color-pine) underline">{_('dest.source.link')}</a>
        )}
      </div>

      {d.touristPass?.name && (
        <div class="rounded-xl border border-(--color-line) bg-white p-5">
          <h2 class="text-sm font-semibold">{_('dest.pass.title')}</h2>
          <p class="mt-2 text-sm text-(--color-ink-2)">{d.touristPass.name}</p>
          {d.touristPass.url && (
            <a href={d.touristPass.url} {...linkAttrs(d.touristPass.url)} class="mt-2 inline-block text-sm font-semibold text-(--color-terra) underline">{_('dest.pass.link')}</a>
          )}
        </div>
      )}
      <div class="rounded-xl border border-(--color-line) bg-white p-5">
        <h2 class="text-sm font-semibold">{_('dest.channels.title')}</h2>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {channelsOf(d).map((c: string) => (
            <span class="rounded-full bg-(--color-paper-3) px-3 py-1 text-xs font-semibold">{channelLabel(_, c)}</span>
          ))}
        </div>
        {d.voiceId && <p class="mt-3 text-xs text-(--color-ink-3)">{_('dest.voice.id')} <code>{d.voiceId}</code></p>}
      </div>

      <div class="rounded-xl border border-(--color-amber) bg-(--color-amber-l) p-5">
        <h2 class="text-sm font-semibold">{_('dest.own.title')}</h2>
        <p class="mt-2 text-sm text-(--color-ink-2)">{_('dest.own.body')}</p>
        <a href="/business" class="mt-3 inline-block rounded-full bg-(--color-amber) px-4 py-2 text-sm font-semibold text-white">
          {_('dest.own.cta')}
        </a>
      </div>
    </aside>
  </div>

  {siblings.length > 0 && (
    <>
      <div class="mt-14 flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="h-section">
          {curatedCount > 0 ? _('dest.highlights', { country }) : _('dest.more', { country })}
        </h2>
        <a href={localeHref(locale, `/countries/${d.country.toLowerCase()}`)}
           class="text-sm font-semibold text-(--color-pine) underline">{_('dest.all', { country })}</a>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {siblings.map((s: any) => <DestinationCard d={s} locale={locale} />)}
      </div>
    </>
  )}
</section>
