---
/**
 * Landsdekkende concierge bovenaan een landpagina.
 *
 * Bewust géén bestemmingskaart. Een land is geen bestemming naast zijn eigen
 * steden: als `France` een record in destinations.json zou zijn, stond hij als
 * kaart tussen Lille en Lyon én telde hij mee in "200 destinations in France".
 * Dat getal moet blijven zeggen wat het zegt.
 *
 * Rendert niets als er voor dit land geen landelijke tenant is — de meeste
 * landen hebben er geen, en een lege balk is erger dan geen balk.
 *
 * EU-first, net als de bestemmingspagina's: heeft de tenant een -eu twin, dan
 * opent de knop die, met de EU-badge erbij. De sociale kanalen (WhatsApp,
 * Messenger, Instagram) draaien alleen op de internationale tenant; ze staan
 * eronder, met een eerlijke regel dat dat US-AI is en niet de EU-keten.
 */
import ProvenanceBadge from './ProvenanceBadge.astro';
import EuSovereignBadge from './EuSovereignBadge.astro';
import { t, DEFAULT_LOCALE, type Locale } from '../i18n/ui';

interface Props {
  c: {
    tenantId: string;
    chatUrl: string;
    logo?: string | null;
    brandColor?: string | null;
    website?: string | null;
    provenance: 'official' | 'preview';
    dataSource?: string | null;
    euTenantId?: string | null;
    social?: {
      whatsapp?: string;        // E.164 zonder plus, bv. 33775493743
      whatsappCall?: boolean;
      messenger?: string;       // page-slug voor m.me
      instagram?: string;       // handle voor ig.me
      telegram?: string;        // botnaam zonder @, voor t.me
      facebookUrl?: string;
      instagramUrl?: string;
    } | null;
  } | null;
  /** De landnaam in de taal van de pagina, zoals de kop hem al toont. */
  country: string;
  /** Naam van de bron, alleen als de connector het hele land dekt. */
  sourceName?: string;
  locale?: Locale;
}

const { c, country, sourceName, locale = DEFAULT_LOCALE } = Astro.props;
const _ = t(locale);
const accent = c?.brandColor || 'var(--color-pine)';
const eu = !!c?.euTenantId;
const chatUrl = c ? (eu ? `https://chat.dm2find.ai/${c.euTenantId}` : c.chatUrl) : '';

/* Eén knop per kanaal, elk met een link die de app direct opent. */
const waText = encodeURIComponent(_('country.social.wa.text', { country }));
const fmtPhone = (n: string) => n.startsWith('33') && n.length === 11
  ? `+33 ${n[2]} ${n.slice(3, 5)} ${n.slice(5, 7)} ${n.slice(7, 9)} ${n.slice(9, 11)}`
  : `+${n}`;
const social = c?.social
  ? [
      ...(c.social.whatsapp ? [{ k: 'wa', label: _('country.social.wa'), sub: fmtPhone(c.social.whatsapp), href: `https://wa.me/${c.social.whatsapp}?text=${waText}` }] : []),
      ...(c.social.whatsapp && c.social.whatsappCall ? [{ k: 'wacall', label: _('country.social.wacall'), sub: _('country.social.wacall.sub'), href: `https://wa.me/${c.social.whatsapp}` }] : []),
      ...(c.social.messenger ? [{ k: 'messenger', label: 'Messenger', sub: '@' + c.social.messenger, href: `https://m.me/${c.social.messenger}` }] : []),
      ...(c.social.instagram ? [{ k: 'instagram', label: 'Instagram', sub: '@' + c.social.instagram, href: `https://ig.me/m/${c.social.instagram}` }] : []),
      ...(c.social.telegram ? [{ k: 'telegram', label: 'Telegram', sub: '@' + c.social.telegram, href: `https://t.me/${c.social.telegram}` }] : []),
    ]
  : [];
---

{c && (
  <section class="mt-8 overflow-hidden rounded-2xl border border-(--color-line) bg-(--color-paper-2)">
    <div class="h-1 w-full" style={`background:${accent}`}></div>
    <div class="flex flex-col gap-5 p-6 sm:flex-row sm:items-center">
      {c.logo && (
        <img src={c.logo} alt="" width="64" height="64" loading="lazy"
             class="h-16 w-16 shrink-0 rounded-xl object-cover" />
      )}
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="h-section">{_('country.national.title', { country })}</h2>
          <ProvenanceBadge provenance={c.provenance}
                           sourceName={c.provenance === 'official' ? sourceName : undefined}
                           locale={locale} />
          {eu && <EuSovereignBadge locale={locale} />}
        </div>
        <p class="mt-2 max-w-2xl text-(--color-ink-2)">{_('country.national.body')}</p>
        {eu && (
          <p class="mt-1 text-sm text-(--color-ink-3)">
            {_('eu.intl')} <a href={c.chatUrl} target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-2">{_('eu.intl.link')}</a>
          </p>
        )}
      </div>
      <a href={chatUrl} target="_blank" rel="noopener noreferrer"
         class="inline-flex shrink-0 items-center justify-center rounded-xl px-5 py-3 text-sm font-semibold text-white transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
         style={`background:${accent};outline-color:${accent}`}>
        {_('country.national.cta', { country })}
      </a>
    </div>

    {social.length > 0 && (
      <div class="border-t border-(--color-line-2) bg-white px-6 py-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <h3 class="text-xs font-bold tracking-widest text-(--color-ink-3) uppercase" style="font-family:var(--font-sans)">{_('country.social.title')}</h3>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-(--color-amber-l) px-2.5 py-0.5 text-[11px] font-semibold text-(--color-amber)">
            <span class="h-1.5 w-1.5 rounded-full bg-current"></span> {_('country.social.badge')}
          </span>
        </div>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
          {social.map(s => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer"
                 class="flex items-center gap-3 rounded-xl border border-(--color-line) bg-white px-4 py-3 transition hover:border-(--color-ink-3)">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-(--color-paper-2) text-(--color-ink)" aria-hidden="true">
                  {s.k === 'wa' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-13.4 7.8L3 21l1.2-4.4A9 9 0 1 1 21 12Z" /><path d="M9 10.5c.3 1.6 1.9 3.2 3.5 3.5l1.3-1.2 1.7.6-.3 1.6c-3.2.6-7.2-3.4-6.6-6.6l1.6-.3.6 1.7L9 10.5Z" /></svg>
                  )}
                  {s.k === 'wacall' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" /></svg>
                  )}
                  {s.k === 'messenger' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 8.5 0 0 0-5 15.6V21l2.9-1.6A10 10 0 0 0 12 20a9 8.5 0 0 0 0-17Z" /><path d="m7.5 13 3-3.5 2.5 2 3.5-3.5" /></svg>
                  )}
                  {s.k === 'telegram' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 4 3 11l5.5 2L17 7l-6.5 7.5L10.5 20l3-3.5 4.5 3L21 4Z" /></svg>
                  )}
                  {s.k === 'instagram' && (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="3.8" /><circle cx="17.3" cy="6.7" r=".8" fill="currentColor" /></svg>
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-(--color-ink)">{s.label}</span>
                  {s.sub && <span class="block truncate text-xs text-(--color-ink-3)">{s.sub}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-(--color-ink-3)">{_('country.social.note')}</p>
      </div>
    )}
  </section>
)}
