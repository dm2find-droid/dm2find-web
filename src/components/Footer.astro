---
import { t, localeHref, DEFAULT_LOCALE, type Locale } from '../i18n/ui';
interface Props { locale?: Locale }
const { locale = DEFAULT_LOCALE } = Astro.props;
const _ = t(locale);
---
<footer class="mt-16 bg-(--color-ink) py-12 text-sm text-[#98A39D]">
  <div class="mx-auto grid max-w-6xl gap-7 px-5 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="font-serif text-xl font-semibold text-white">DM2find<span class="text-[#E08B62]">.ai</span></div>
      <p class="mt-3 max-w-[34ch]">{_('footer.tagline')}</p>
      <a href="mailto:sales@dm2find.ai" class="mt-3 inline-block text-white">sales@dm2find.ai</a>
    </div>
    <div><h2 class="mb-3 text-xs font-semibold tracking-widest text-white uppercase">{_('footer.travel')}</h2>
      <a class="block py-1 hover:text-white" href="/travel">{_('footer.find')}</a>
      <a class="block py-1 hover:text-white" href={localeHref(locale, '/destinations')}>{_('footer.all')}</a>
      <a class="block py-1 hover:text-white" href="/channels">{_('footer.channels')}</a></div>
    <div><h2 class="mb-3 text-xs font-semibold tracking-widest text-white uppercase">{_('footer.business')}</h2>
      <a class="block py-1 hover:text-white" href="/business">{_('footer.claim')}</a>
      <a class="block py-1 hover:text-white" href="/venues">{_('footer.venues')}</a>
      <a class="block py-1 hover:text-white" href="/pricing">{_('footer.pricing')}</a></div>
    <div><h2 class="mb-3 text-xs font-semibold tracking-widest text-white uppercase">{_('footer.orgs')}</h2>
      <a class="block py-1 hover:text-white" href="/dmo">{_('footer.dmos')}</a>
      <a class="block py-1 hover:text-white" href="/platform">{_('footer.platform')}</a></div>
    <div class="border-t border-[#33403A] pt-5 text-xs text-[#78837D] sm:col-span-2 lg:col-span-4">
      {_('footer.legal')}
    </div>
  </div>
</footer>
