---
import DestinationCard from './DestinationCard.astro';
import { t, localeHref, DEFAULT_LOCALE, type Locale } from '../i18n/ui';

interface Props { all: any[]; countries: string[]; channels: string[]; venueCount: number; locale?: Locale }
const { all, countries, channels, venueCount, locale = DEFAULT_LOCALE } = Astro.props;
const _ = t(locale);

/* Search key, folded at build time so the browser never does this work and so
   "zurich" finds Zürich, "malaga" finds Málaga, "hertogenbosch" finds
   's-Hertogenbosch. Region and country are included because people search
   "normandie" or "tirol" as often as they search a town. */
const fold = (s: string) => (s ?? '').normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
const key = (d: any) => [d.name.en, d.region, d.countryName, d.slug].filter(Boolean).map(fold).join(' ');
---
<section class="mx-auto max-w-6xl px-5 py-12">
  <h1 class="h-display">{_('index.title')}</h1>
  <p class="lede mt-4">{_('index.lede')}</p>

  <div class="relative mt-8">
    <svg class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-(--color-ink-3)"
         width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
      <path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <input id="q" type="search" autocomplete="off" enterkeyhint="go"
           placeholder={_('index.search')} aria-label={_('index.searchAria')}
           class="w-full rounded-xl border border-(--color-line) bg-white py-3.5 pr-4 pl-11 text-base
                  outline-none placeholder:text-(--color-ink-3) focus:border-(--color-pine)" />
  </div>

  <div class="mt-3 rounded-xl border border-(--color-line) bg-white px-5 py-2">
    <div class="flex flex-wrap items-start gap-2 border-b border-(--color-line-2) py-3">
      <span class="w-24 pt-2 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">{_('index.country')}</span>
      <div class="flex flex-1 flex-wrap gap-1.5">
        <button class="f-chip" data-k="country" data-v="All">{_('index.all')}</button>
        {countries.map(c => <button class="f-chip" data-k="country" data-v={c}>{c}</button>)}
      </div>
    </div>
    <div class="flex flex-wrap items-start gap-2 border-b border-(--color-line-2) py-3">
      <span class="w-24 pt-2 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">{_('index.channel')}</span>
      <div class="flex flex-1 flex-wrap gap-1.5">
        <button class="f-chip" data-k="channel" data-v="All">{_('index.all')}</button>
        {channels.map(c => <button class="f-chip" data-k="channel" data-v={c}>{c}</button>)}
      </div>
    </div>
    <div class="flex flex-wrap items-start gap-2 py-3">
      <span class="w-24 pt-2 text-xs font-bold tracking-widest text-(--color-ink-3) uppercase">{_('index.data')}</span>
      <div class="flex flex-1 flex-wrap gap-1.5">
        <button class="f-chip" data-k="prov" data-v="All">{_('index.all')}</button>
        <button class="f-chip" data-k="prov" data-v="official">{_('index.official')}</button>
        <button class="f-chip" data-k="prov" data-v="preview">{_('index.public')}</button>
      </div>
    </div>
  </div>

  <p class="mt-5 text-sm text-(--color-ink-3)">
    <span id="count"></span>
    <a href="/venues" class="ml-1 font-semibold text-(--color-pine) underline">{_('index.andVenues', { n: venueCount })}</a>
  </p>
  {/* De teller draait in de browser en moet dus de vertaalde sjablonen kennen. */}
  <div id="i18n" hidden
       data-one={_('index.count.one', { n: '%n' })}
       data-many={_('index.count.many', { n: '%n' })}
       data-matching={_('index.matching', { q: '%q' })}></div>
  <div id="grid" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {all.map(d => (
      <div class="d-item" data-country={d.countryName} data-prov={d.provenance}
           data-channel={d.channels.join('|')} data-k={key(d)}>
        <DestinationCard d={d} locale={locale} />
      </div>
    ))}
  </div>
  <div id="empty" class="mt-6 hidden rounded-xl border border-(--color-line) bg-white p-8 text-center">
    <p class="font-semibold">{_('index.empty.title')}</p>
    <p class="mt-1.5 text-sm text-(--color-ink-2)">{_('index.empty.body')}</p>
    <button id="reset" class="mt-4 rounded-full bg-(--color-pine) px-5 py-2.5 text-sm font-semibold text-white">
      {_('index.reset')}
    </button>
  </div>
</section>

<style is:global>
  .f-chip { border:1px solid var(--color-line); background:#fff; border-radius:9999px;
    padding:.45rem .85rem; font-size:.83rem; color:var(--color-ink-2); cursor:pointer }
  .f-chip[data-on] { background:var(--color-ink); color:#fff; border-color:var(--color-ink) }
</style>
<script>
  const F: Record<string,string> = { country:'All', channel:'All', prov:'All' };
  const chips = document.querySelectorAll<HTMLElement>('.f-chip');
  const items = document.querySelectorAll<HTMLElement>('.d-item');
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const q     = document.getElementById('q') as HTMLInputElement;
  const T     = document.getElementById('i18n')!.dataset;

  // same folding as the build-time key, so accents never block a match
  const fold = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().trim();
  let visible: HTMLElement[] = [];

  const paint = () => {
    chips.forEach(c => {
      const on = F[c.dataset.k!] === c.dataset.v;
      on ? c.setAttribute('data-on','') : c.removeAttribute('data-on');
    });
    // every whitespace-separated word must appear, so "groningen nl" narrows
    const words = fold(q.value).split(/\s+/).filter(Boolean);
    visible = [];
    items.forEach(i => {
      const ok = (F.country==='All' || i.dataset.country===F.country)
              && (F.prov==='All'    || i.dataset.prov===F.prov)
              && (F.channel==='All' || (i.dataset.channel||'').split('|').includes(F.channel))
              && words.every(w => (i.dataset.k||'').includes(w));
      i.style.display = ok ? '' : 'none';
      if (ok) visible.push(i);
    });
    const n = visible.length;
    const base = (n === 1 ? T.one! : T.many!).replace('%n', String(n));
    const match = words.length ? T.matching!.replace('%q', q.value.trim()) : '';
    count.textContent = n ? base + match : '';
    empty.classList.toggle('hidden', n > 0);
  };

  chips.forEach(c => c.addEventListener('click', () => { F[c.dataset.k!] = c.dataset.v!; paint(); }));
  q.addEventListener('input', paint);
  q.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { q.value = ''; paint(); }
    // Enter opens the destination when the search has narrowed to one
    if (e.key === 'Enter' && visible.length === 1) {
      const a = visible[0].querySelector('a');
      if (a) window.location.href = a.getAttribute('href')!;
    }
  });
  document.getElementById('reset')!.addEventListener('click', () => {
    q.value = ''; F.country = F.channel = F.prov = 'All'; paint(); q.focus();
  });
  paint();
</script>
